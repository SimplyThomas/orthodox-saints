---
/* The lead story's plate on the front page. No image and no cross ornament —
   the subject's initial set large in the paper's serif, inside a thin gold
   frame, with the slug line a paper prints under a picture. */
import type { NewsSaintRef } from "../../lib/daily-dove";

interface Props {
  saint?: NewsSaintRef;
  height?: number;
  slug?: string;
  radius?: number;
  fill?: boolean;
}
const { saint, height = 240, slug, radius = 0, fill = false } = Astro.props;
const initial = (saint?.name ?? "").trim().charAt(0).toUpperCase();
---

<div
  class="news-plate"
  style={`height:${fill ? "100%" : height + "px"}${radius ? `;border-radius:${radius}px` : ""}`}
>
  <div class="np-frame" aria-hidden="true"></div>
  {
    initial && (
      <span class="np-initial" aria-hidden="true">
        {initial}
      </span>
    )
  }
  {slug && <div class="np-slug">{slug}</div>}
</div>

<style>
  .news-plate {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(150deg, #1b3a5c, #234c7a 60%, #1d4068);
    min-height: 240px;
  }
  .np-frame {
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    pointer-events: none;
  }
  .np-initial {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(90px, 13vw, 170px);
    line-height: 1;
    color: rgba(245, 235, 216, 0.26);
    user-select: none;
  }
  .np-slug {
    position: absolute;
    left: 20px;
    bottom: 16px;
    right: 20px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--gold-soft);
    opacity: 0.85;
  }
</style>
