---
/* Sidebar building block: a gold-ruled eyebrow above whatever the module holds.
   The section prints on newsprint, so the eyebrow needs no on-dark variant. */
interface Props {
  eyebrow: string;
}
const { eyebrow } = Astro.props;
---

<div class="rail-mod">
  <div class="rail-mod-head">
    <span class="eyebrow">{eyebrow}</span>
    <span class="rail-mod-ln" aria-hidden="true"></span>
  </div>
  <slot />
</div>

<style>
  .rail-mod {
    margin-bottom: 30px;
  }
  .rail-mod-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .rail-mod-ln {
    flex: 1;
    height: 1px;
    background: var(--line-gold);
  }
</style>
