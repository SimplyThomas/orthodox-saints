---
/* An account as a card: thumbnail on top under a rule in its era's colour, the
   verification mark overlaid, then the badges, headline, meta and summary.
   Used by the filtered grid on /news and the related-articles row on an
   article page. */
import type { NewsItem } from "../../lib/daily-dove";
import { NEWS_CAT, regionOf, eraOf } from "../../lib/daily-dove";
import { withBase } from "../../lib/format";
import NewsThumb from "./NewsThumb.astro";
import NewsMeta from "./NewsMeta.astro";
import EraPill from "./EraPill.astro";
import CenturyBadge from "./CenturyBadge.astro";
import EvidenceDot from "./EvidenceDot.astro";

interface Props {
  n: NewsItem;
}
const { n } = Astro.props;
const cat = NEWS_CAT[n.cat];
const era = eraOf(n.century);
const eraBg = `linear-gradient(150deg, color-mix(in srgb, ${era.ink} 78%, #000), color-mix(in srgb, ${era.ink} 58%, #000))`;
// The filter island matches against these without re-reading the DOM text.
const haystack =
  `${n.headline} ${n.location} ${n.summary} ${n.saint.name} ${cat.name}`.toLowerCase();
---

<a
  class="news-feed-card"
  href={withBase(`daily-dove/${n.id}`)}
  style={`border-top-color:${era.ink}`}
  data-cat={n.cat}
  data-era={era.id}
  data-century={n.century}
  data-verify={n.evidence}
  data-region={regionOf(n.location)}
  data-saint={n.saint.name}
  data-search={haystack}
>
  <div class="nfc-media">
    <NewsThumb saint={n.saint} bg={eraBg} height={176} />
    <span class="nfc-verify">
      <EvidenceDot level={n.evidence} withLabel={false} />
    </span>
  </div>
  <div class="nfc-body">
    <div class="nfc-tags">
      <EraPill century={n.century} />
      <CenturyBadge century={n.century} />
    </div>
    <h3 class="nfc-h">{n.headline}</h3>
    <NewsMeta date={n.date} location={n.location} size={12} />
    <p class="nfc-sum">{n.summary}</p>
    <span class="nfc-read">
      Read the account
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
      >
    </span>
  </div>
</a>

<style>
  .news-feed-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #fff;
    border: 1px solid var(--line);
    border-top: 4px solid var(--byz);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .news-feed-card:hover {
    background: var(--paper);
  }
  .nfc-media {
    position: relative;
  }
  .nfc-verify {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(251, 246, 234, 0.94);
    border-radius: 4px;
    padding: 4px 7px;
    box-shadow: 0 2px 8px rgba(15, 34, 56, 0.18);
  }
  .nfc-body {
    padding: 17px 20px 19px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .nfc-tags {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 11px;
    flex-wrap: wrap;
  }
  .nfc-h {
    font-family: var(--serif);
    font-size: 21px;
    color: var(--byz-deep);
    line-height: 1.16;
    margin: 0 0 8px;
    text-wrap: pretty;
  }
  .news-feed-card:hover .nfc-h {
    text-decoration: underline;
    text-decoration-color: var(--line-gold);
    text-underline-offset: 3px;
  }
  .nfc-sum {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.58;
    margin: 9px 0 0;
    text-wrap: pretty;
  }
  .nfc-read {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    color: var(--byz);
    margin-top: auto;
    padding-top: 14px;
  }
</style>
