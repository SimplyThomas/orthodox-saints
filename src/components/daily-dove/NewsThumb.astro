---
/* The plate at the left of a dispatch row and the head of a card.

   The paper carries no images and no cross ornament, so this is simply the
   subject's initial set large in the paper's own serif on the era's colour —
   a printer's block, not a picture. It reads as deliberate at any size and
   never looks like a slot waiting to be filled. */
import type { NewsSaintRef } from "../../lib/daily-dove";

interface Props {
  saint?: NewsSaintRef;
  /** the ground; defaults to the deep blue used before eras were introduced */
  bg?: string;
  height?: number;
}
const { saint, bg, height } = Astro.props;
const initial = (saint?.name ?? "").trim().charAt(0).toUpperCase();
const ground = bg ?? "linear-gradient(150deg,#1f4168,#234C7A)";
---

<div
  class="news-thumb"
  style={`background:${ground}${height ? `;height:${height}px` : ""}`}
  aria-hidden="true"
>
  {initial && <span class="nt-initial">{initial}</span>}
</div>

<style>
  .news-thumb {
    position: relative;
    height: 100%;
    min-height: 158px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nt-initial {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(52px, 9vw, 86px);
    line-height: 1;
    color: rgba(245, 235, 216, 0.32);
    letter-spacing: 0.02em;
    user-select: none;
  }
</style>
