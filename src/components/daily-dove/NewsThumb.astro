---
/* A calm, uniform thumbnail — the frameless sibling of NewsPlate: no gold inner
   frame, no monospace slug, and an optional `bg` override so a dispatch row can
   tint its thumb with its own desk colour. */
import type { NewsSaintRef } from "../../lib/daily-dove";
import { saintAvatar, domeMark, byzCross } from "../../lib/icons";

interface Props {
  saint?: NewsSaintRef;
  tone?: "blue" | "ivory";
  motif?: "dome" | "cross";
  /** overrides the tone's gradient — used for desk-coloured dispatch rows */
  bg?: string;
  height?: number;
}
const { saint, tone = "blue", motif = "dome", bg, height } = Astro.props;

const T = bg
  ? { bg, mark: "#D4AF37", markOp: 0.16 }
  : tone === "ivory"
    ? {
        bg: "linear-gradient(150deg,#efe3cb,#e7d9bd)",
        mark: "#234C7A",
        markOp: 0.08,
      }
    : {
        bg: "linear-gradient(150deg,#1f4168,#234C7A)",
        mark: "#D4AF37",
        markOp: 0.15,
      };

const watermark =
  motif === "cross" ? byzCross(118, T.mark, 1.3) : domeMark(230, T.mark);
const portrait = saint
  ? saintAvatar({ name: saint.name, type: saint.type }, 64, 80, {
      type: saint.type,
    })
  : "";
---

<div
  class="news-thumb"
  style={`background:${T.bg}${height ? `;height:${height}px` : ""}`}
>
  <div class="nt-mark" style={`opacity:${T.markOp}`} set:html={watermark} />
  {portrait && <div class="nt-icon" set:html={portrait} />}
</div>

<style>
  .news-thumb {
    position: relative;
    height: 100%;
    min-height: 158px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nt-mark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .nt-icon {
    position: relative;
    filter: drop-shadow(0 8px 22px rgba(15, 34, 56, 0.3));
    display: flex;
  }
</style>
