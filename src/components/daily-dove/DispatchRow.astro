---
/* A dispatch in the chronological feed: a wide row printed in the colour of its
   era, thumbnail left and account right. Dark by design — the feed sits on the
   deep navy band, so the plates read as colour against it, and a reader can
   date a story from across the room. */
import type { NewsItem } from "../../lib/daily-dove";
import { eraOf } from "../../lib/daily-dove";
import { withBase } from "../../lib/format";
import NewsThumb from "./NewsThumb.astro";
import EraPill from "./EraPill.astro";
import CenturyBadge from "./CenturyBadge.astro";
import EvidenceDot from "./EvidenceDot.astro";
import NewsMeta from "./NewsMeta.astro";

interface Props {
  n: NewsItem;
}
const { n } = Astro.props;
const era = eraOf(n.century);
const thumbBg = `linear-gradient(150deg, color-mix(in srgb, ${era.ink} 76%, #000), color-mix(in srgb, ${era.ink} 55%, #000))`;
---

<a
  class="drow"
  href={withBase(`daily-dove/${n.id}`)}
  style={`background:${era.ink}`}
  data-cat={n.cat}
  data-era={era.id}
>
  <div class="drow-media">
    <NewsThumb saint={n.saint} bg={thumbBg} />
    <span class="drow-verify">
      <EvidenceDot level={n.evidence} withLabel={false} />
    </span>
  </div>
  <div class="drow-body">
    <div class="drow-tags">
      <EraPill century={n.century} onDark />
      <CenturyBadge century={n.century} color="var(--gold-soft)" />
    </div>
    <h3 class="drow-h">{n.headline}</h3>
    <NewsMeta
      date={n.date}
      location={n.location}
      size={13}
      color="rgba(245,235,216,.74)"
    />
    <p class="drow-sum">{n.summary}</p>
    <span class="drow-read">
      Read the account
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
      >
    </span>
  </div>
</a>

<style>
  .drow {
    display: grid;
    grid-template-columns: 196px 1fr;
    text-decoration: none;
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .drow-media {
    position: relative;
  }
  .drow-verify {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(251, 246, 234, 0.94);
    border-radius: 4px;
    padding: 4px 7px;
    box-shadow: 0 2px 8px rgba(15, 34, 56, 0.18);
  }
  .drow-body {
    padding: 20px 26px 22px;
    display: flex;
    flex-direction: column;
  }
  .drow-tags {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .drow-h {
    font-family: var(--serif);
    font-size: 25px;
    color: var(--ivory);
    line-height: 1.13;
    margin: 0 0 9px;
    text-wrap: pretty;
  }
  .drow:hover .drow-h {
    text-decoration: underline;
    text-decoration-color: var(--line-gold);
    text-underline-offset: 3px;
  }
  .drow-sum {
    font-size: 14.5px;
    color: rgba(245, 235, 216, 0.84);
    line-height: 1.6;
    margin: 10px 0 0;
    text-wrap: pretty;
  }
  .drow-read {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    color: var(--gold-soft);
    margin-top: 14px;
  }
  @media (max-width: 720px) {
    .drow {
      grid-template-columns: 1fr;
    }
    .drow-media :global(.news-thumb) {
      min-height: 180px;
    }
    .drow-body {
      padding: 18px 20px 20px;
    }
    .drow-h {
      font-size: 21px;
    }
  }
</style>
