---
/* The standing pill row under a dispatch's summary: WHEN · WHO · WHAT KIND.

   One component rather than a hand-assembled row at each call site, because the
   set is the point — a reader learns to read the three positions once and then
   reads every dispatch the same way. Assembled inline in two places, they drift
   within a week.

   Order is deliberate and is the order the questions get asked: which age is
   this from, whose story is it, and what was asked for.

   The wonder pills are CAPPED. A dispatch can report five kinds of help, and
   five dashed pills after the era and the saint is a badge rack rather than a
   row — the rest are on the dispatch itself and in the archive's facets. */
import type { NewsItem } from "../../lib/daily-dove";
import EraPill from "./EraPill.astro";
import SaintPill from "./SaintPill.astro";
import WonderPill from "./WonderPill.astro";

interface Props {
  n: NewsItem;
  size?: number;
  /** how many kind-of-help pills to show at most */
  maxWonders?: number;
  /** render the pills as plain marks, with no links out */
  plain?: boolean;
}
const { n, size = 10.5, maxWonders = 2, plain = false } = Astro.props;
const wonders = (n.miracles ?? []).slice(0, maxWonders);
---

<div class="dpills">
  <EraPill century={n.century} size={size} />
  <SaintPill
    saint={n.saint}
    subjects={n.subjects}
    label={n.saintLabel}
    size={size}
  />
  {wonders.map((w) => <WonderPill wonder={w} size={size} plain={plain} />)}
</div>

<style>
  .dpills {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
</style>
