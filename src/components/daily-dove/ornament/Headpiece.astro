---
/* A headpiece — the engraved band a printer sets above a section, with a motif
   at its centre and scrollwork running out to the margins.

   This is where the archive stops being one paper. Each era of Church history
   carries its own motif (see Era.motif in lib/daily-dove.ts), so a sheet from
   the Age of the Martyrs is headed by a Chi-Rho and a sheet from the Ottoman
   centuries by a crescent-and-star. The band is otherwise identical everywhere:
   the identity holds, the age shows through it. Subtle on purpose — the moment
   an era starts wearing a costume, the archive reads as a theme park. */
import type { Era } from "../../../lib/daily-dove";

interface Props {
  /** the era whose motif to draw; omit for the paper's own cross-and-lozenge */
  era?: Era;
  color?: string;
  /** height of the motif medallion */
  size?: number;
  /** rules run out to the margins on both sides (default) or neither */
  rules?: boolean;
}
const { era, color = "var(--gold)", size = 26, rules = true } = Astro.props;

/* Each motif is drawn to a 24×24 box, stroked in currentColor so it inherits
   the band's ink. Kept to line work: an engraver's plate, not an illustration. */
const MOTIFS: Record<string, string[]> = {
  // Chi-Rho — the monogram scratched on the catacomb walls
  "chi-rho": [
    "M6.5 8.5 17.5 19.5",
    "M17.5 8.5 6.5 19.5",
    "M12 4.5v15",
    "M12 5.2h1.9a3.1 3.1 0 0 1 0 6.2H12",
  ],
  // the patriarchal cross of the conciliar age
  "council-cross": ["M12 3v18", "M8.5 7.2h7", "M6 12.4h12", "M9.5 17.4h5"],
  // the vine of the imperial centuries — "I am the vine, ye are the branches"
  vine: [
    "M2.5 12c3.2-6 6.3-6 9.5 0 3.2 6 6.3 6 9.5 0",
    "M7.2 9.2c-.2-2 .8-3.2 2.4-3.4",
    "M16.8 14.8c.2 2-.8 3.2-2.4 3.4",
    "M12 12v0",
  ],
  // the interlace of the north — Rus' and the Holy Mountain
  knot: [
    "M12 4.5 19.5 12 12 19.5 4.5 12Z",
    "M12 8 16 12l-4 4-4-4Z",
    "M4.5 12H2m20 0h-2.5",
  ],
  // crescent and star — the sheets filed under another sovereign
  "crescent-star": [
    "M14.6 5.4a7 7 0 1 0 0 13.2 8 8 0 0 1 0-13.2Z",
    "M18.4 9.2l.9 2.2 2.2.9-2.2.9-.9 2.2-.9-2.2-2.2-.9 2.2-.9Z",
  ],
  // a rosette for the modern editions
  rose: [
    "M12 5.5c2 0 3.2 1.5 3.2 3.2S14 12 12 12s-3.2-1.6-3.2-3.3S10 5.5 12 5.5Z",
    "M12 12c1.7 1 2.2 2.8 1.4 4.3-.9 1.5-2.7 1.9-4.4.9",
    "M12 12c-1.7 1-3.5.6-4.4-.9-.8-1.5-.3-3.3 1.4-4.3",
    "M12 12c0 2 1.3 3.4 3.1 3.6",
    "M12 12c0 2-1.3 3.4-3.1 3.6",
  ],
  // the paper's own mark, where no era is named
  dove: ["M12 4v16", "M6.5 9.5h11", "M12 4 8.6 7.4M12 4l3.4 3.4", "M9 20h6"],
};

const paths = MOTIFS[era?.motif ?? "dove"] ?? MOTIFS.dove;
---

<div class="hpiece" style={`color:${color}`} aria-hidden="true">
  {rules && <span class="hpiece-ln hpiece-ln--l" />}
  <span class="hpiece-dm"></span>
  <svg
    class="hpiece-motif"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {paths.map((d) => <path d={d} />)}
  </svg>
  <span class="hpiece-dm"></span>
  {rules && <span class="hpiece-ln hpiece-ln--r" />}
</div>

<style>
  .hpiece {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    width: 100%;
  }
  /* the rule thins as it leaves the medallion, the way an engraved band does */
  .hpiece-ln {
    flex: 1 1 0;
    min-width: 0;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }
  .hpiece-ln--l {
    background: linear-gradient(90deg, transparent, currentColor);
  }
  .hpiece-ln--r {
    background: linear-gradient(270deg, transparent, currentColor);
  }
  .hpiece-dm {
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
    background: currentColor;
    flex: 0 0 auto;
    opacity: 0.85;
  }
  .hpiece-motif {
    flex: 0 0 auto;
  }
</style>
