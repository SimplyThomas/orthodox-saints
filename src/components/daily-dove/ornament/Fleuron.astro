---
/* A printer's fleuron — the aldus leaf a compositor sets between sections when
   a rule would be too loud. The paper uses it as its dinkus: between the briefs,
   under a department head, either side of a folio line.

   Drawn rather than typed. The ❦ character exists, but it renders in whatever
   the fallback font decides and lands differently in every browser; a path is
   the same shape everywhere and takes the era's ink. */
interface Props {
  size?: number;
  color?: string;
  /** three points in a row, the way a section break is set */
  triple?: boolean;
  /** turn it on its side, for a vertical run */
  rotate?: number;
}
const {
  size = 14,
  color = "var(--gold)",
  triple = false,
  rotate,
} = Astro.props;
const leaf =
  "M12 3.2c-2.6 1.6-4.4 3.6-4.4 6 0 1.9 1.3 3.3 3 3.3.9 0 1.6-.4 2-1v6.3c0 .7.6 1.2 1.2.6.4-.4.4-1 0-1.4-.5-.5-.6-1-.6-1.7V11.5c.4.6 1.1 1 2 1 1.7 0 3-1.4 3-3.3 0-2.4-1.8-4.4-4.4-6a1 1 0 0 0-1.8 0Z";
---

<span
  class:list={["fleu", triple && "fleu--triple"]}
  style={`color:${color}${rotate ? `;transform:rotate(${rotate}deg)` : ""}`}
  aria-hidden="true"
>
  {
    (triple ? [0, 1, 2] : [0]).map((i) => (
      <svg
        width={size}
        height={size}
        viewBox="0 0 24 24"
        fill="currentColor"
        style={i === 1 ? "opacity:1" : "opacity:.62"}
      >
        <path d={leaf} />
      </svg>
    ))
  }
</span>

<style>
  .fleu {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    flex: 0 0 auto;
  }
  .fleu--triple {
    gap: 5px;
  }
</style>
