---
/* The evidence mark with the standard spelled out beneath it. Used in the
   article's metadata bar, where there is room to say what the level means
   rather than relying on the colour alone. */
import type { EvidenceLevel } from "../../lib/daily-dove";
import { EVIDENCE } from "../../lib/daily-dove";

interface Props {
  level: EvidenceLevel;
}
const { level } = Astro.props;
const e = EVIDENCE[level];
---

<span class="ebadge">
  <span
    class="ebadge-mark"
    style={e.dashed
      ? `border:2.5px solid ${e.dot};background:transparent`
      : `background:${e.dot};border:2.5px solid ${e.dot}`}
    aria-hidden="true"></span>
  <span>
    <span class="ebadge-name" style={`color:${e.ink}`}>{e.name}</span>
    <span class="ebadge-full">{e.full}</span>
  </span>
</span>

<style>
  .ebadge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .ebadge-mark {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    flex: 0 0 auto;
    box-sizing: border-box;
  }
  .ebadge-name {
    display: block;
    font-family: var(--text);
    font-weight: 600;
    font-size: 13px;
    line-height: 1.1;
  }
  .ebadge-full {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-size: 11.5px;
    color: var(--ink-soft);
    line-height: 1.2;
    margin-top: 1px;
  }
</style>
