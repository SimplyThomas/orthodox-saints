---
/* The era pill — the label for the colour a dispatch plate is printed in.
   Without it the colour is decoration; with it a reader learns the six bands
   once and can date a story before reading a word of it. */
import { eraOf } from "../../lib/daily-dove";

interface Props {
  century: number;
  size?: number;
  onDark?: boolean;
}
const { century, size = 10.5, onDark = false } = Astro.props;
const era = eraOf(century);
---

<span
  class:list={["erapill", onDark && "erapill--dark"]}
  title={era.full}
  style={`font-size:${size}px;color:${onDark ? "var(--gold-soft)" : era.ink};${onDark ? "" : `background:${era.bg}`}`}
>
  <i style={`background:${era.ink}`} aria-hidden="true"></i>
  {era.name}
</span>

<style>
  .erapill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--text);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 4px 9px;
    border-radius: 2px;
    white-space: nowrap;
  }
  .erapill i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    display: inline-block;
    flex: 0 0 auto;
  }
  /* On the paper's dark stock this is set as a standing label under a gilt
     rule, not a filled chip. A grey rounded rectangle was the last obviously
     modern component left on the front page — a newspaper labels a section with
     type and a rule, never with a pill. The era's own ink stays in the dot, so
     the six colours are still learnable at a glance. */
  .erapill--dark {
    padding: 0 0 3px;
    border-radius: 0;
    background: none;
    border-bottom: 1px solid var(--line-gold);
  }
  .erapill--dark i {
    box-shadow: 0 0 0 1px rgba(245, 235, 216, 0.34);
  }
</style>
