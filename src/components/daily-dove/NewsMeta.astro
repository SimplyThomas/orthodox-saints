---
/* date · location, with quiet glyphs. Extracted from NewsCard now that the
   dispatch rows, the cards and the lead story all carry the same line. */
interface Props {
  date: string;
  location?: string;
  size?: number;
  color?: string;
  gap?: number;
}
const {
  date,
  location,
  size = 12.5,
  color = "var(--ink-soft)",
  gap = 14,
} = Astro.props;
---

<div
  class="news-meta"
  style={`font-size:${size}px;color:${color};gap:${gap}px`}
>
  <span class="nm-item">
    <svg
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><rect x="3" y="4.5" width="18" height="17" rx="2"></rect><path
        d="M3 9h18M8 2.5v4M16 2.5v4"></path></svg
    >{date}
  </span>
  {
    location && (
      <span class="nm-item">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11Z" />
          <circle cx="12" cy="10" r="2.4" />
        </svg>
        {location}
      </span>
    )
  }
</div>
