---
/* The compact verification mark: a boxed letter (A–D) with an optional
   "Level A" label. Sits on cards, on the thumbnail overlay, and beside the
   lead story's call to action. Level D is drawn dashed — it rests on oral
   tradition alone, and the difference should read at a glance. */
import type { VerifyLevel } from "../../lib/news";
import { NEWS_VERIFY } from "../../lib/news";

interface Props {
  level: VerifyLevel;
  withLabel?: boolean;
  onDark?: boolean;
}
const { level, withLabel = true, onDark = false } = Astro.props;
const v = NEWS_VERIFY[level];
---

<span class="vchip" title={`Verification Level ${v.letter} — ${v.full}`}>
  <span
    class="vchip-box"
    style={`border:1px ${v.dashed ? "dashed" : "solid"} ${v.line};background:${v.bg};color:${v.ink}`}
    >{v.letter}</span
  >
  {
    withLabel && (
      <span
        class="vchip-label"
        style={`color:${onDark ? "var(--gold-soft)" : v.ink}`}
      >
        Level {v.letter}
      </span>
    )
  }
</span>

<style>
  .vchip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }
  .vchip-box {
    width: 19px;
    height: 19px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 3px;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
  }
  .vchip-label {
    font-family: var(--text);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
