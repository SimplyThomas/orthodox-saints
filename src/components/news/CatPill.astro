---
/* The desk pill, keyed to the desk's colour. `onDark` swaps to an ivory-on-blue
   treatment for the dark dispatch rows. */
import { NEWS_CAT } from "../../lib/news";

interface Props {
  cat: string;
  short?: boolean;
  size?: number;
  onDark?: boolean;
}
const { cat, short = true, size = 10.5, onDark = false } = Astro.props;
const c = NEWS_CAT[cat] ?? {
  name: cat,
  short: cat,
  ink: "var(--byz)",
  bg: "rgba(35,76,122,.10)",
};
---

<span
  class="catpill"
  style={`font-size:${size}px;color:${onDark ? "var(--ivory)" : c.ink};background:${onDark ? "rgba(245,235,216,.16)" : c.bg}`}
>
  <i
    style={onDark ? "background:var(--gold-soft)" : undefined}
    aria-hidden="true"></i>
  {short ? c.short : c.name}
</span>

<style>
  .catpill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--text);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 4px 9px;
    border-radius: 2px;
    white-space: nowrap;
  }
  .catpill i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    display: inline-block;
    flex: 0 0 auto;
  }
</style>
