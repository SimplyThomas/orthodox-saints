  /* `.sv2 .sv-bodytext` is margin:0 — the saint page uses it for a single
     `brief` paragraph. These profiles run to eight, so consecutive paragraphs
     need a break. Scoped here rather than changed globally, which would move
     every saint and witness page too. */
  .sv-bodytext + .sv-bodytext {
    margin-top: 0.85em;
  }
</style>

<script>
  /* Ask-first chips: open the Q&A deep-dive, open the one answer asked for,
     and bring it into view. Progressive enhancement — without JS the chips do
     nothing and every answer is still reachable in the Q&A section below. */
  for (const chip of document.querySelectorAll<HTMLButtonElement>(
    ".hsv-chip",
  )) {
    chip.addEventListener("click", () => {
      const answer = document.getElementById(`qa-${chip.dataset.q}`);
      if (!answer) return;
      // Open every collapsed ancestor (the Q&A DeepSection wraps the answer).
      let node: HTMLElement | null = answer;
      while (node) {
        if (node instanceof HTMLDetailsElement) node.open = true;
        node = node.parentElement;
      }
      for (const other of document.querySelectorAll(".hsv-qa.is-target")) {
        other.classList.remove("is-target");
      }
      // Restart the flash: the class must land after a reflow to re-run.
      void answer.offsetWidth;
      answer.classList.add("is-target");
      answer.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  }

  /* Share / cite — copy a plain citation + canonical URL, with a Web-Share
     fallback. (Mirrors the saint and witness pages.) */
  const share = document.querySelector<HTMLButtonElement>(".sv-share");
  const shareLabel = share?.querySelector<HTMLElement>(".sv-share-label");
  if (share && shareLabel) {
    const cite = share.dataset.cite || document.title;
    const url = location.href;
    share.addEventListener("click", async () => {
      const text = `${cite} ${url}`;
      try {
        if (navigator.share) {
          await navigator.share({ title: cite, url });
          return;
        }
        await navigator.clipboard.writeText(text);
        const prev = shareLabel.textContent;
        shareLabel.textContent = "Citation copied";
        window.setTimeout(() => {
          shareLabel.textContent = prev;
        }, 1600);
      } catch {
        /* user dismissed the share sheet, or clipboard denied — no-op */
      }
    });
  }
</script>
