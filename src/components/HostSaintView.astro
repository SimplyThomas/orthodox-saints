---
/* Saint-page treatment for the "Guardian Angels & Titled Figures" hosts —
   the angels known by office or title rather than a personal name.
   These carry the fullest prose in the Heavenly Hosts section, so they get the
   full `sv-*` chrome (blue hero, framed portrait, actions ribbon, rail,
   collapsible deep-dives) rather than the plain catalogue layout the ranks and
   biblical encounters use. Same move WitnessSaintView made for /witness: the
   chrome is the shared global `.sv-*` system, and only host-specific bits are
   scoped below. */
import type { Host, HostProfile } from "../lib/hosts";
import { hostById, isBiblicalEncounter } from "../lib/hosts";
import { byId as saintById } from "../lib/data";
import { FEASTS } from "../lib/feasts";
import { withBase } from "../lib/format";
import { saintAvatar } from "../lib/icons";
import { oldCalendarDay } from "../lib/calendar-grid";
import DeepSection from "./DeepSection.astro";

interface Props {
  host: Host;
  profile?: HostProfile;
  backHref: string;
  backLabel: string;
  /** Named angels belonging to this rank — the eight archangels on the
      Archangels page. Empty for every other host. */
  members?: Host[];
}
const { host: h, profile: p, backHref, backLabel, members = [] } = Astro.props;

/** "Archangel Michael" → "Michael" on a roster card, where the rank is the
    heading and repeating it in every name is noise. */
const shortName = (n: string) => n.replace(/^Archangel\s+/, "");

const feastById = new Map(FEASTS.map((f) => [f.id, f]));

/* §9. The default monogram carries a small cross — right for a rank or an
   archangel, wrong for a scriptural *episode* ("The Burning Bush") and plainly
   wrong for a fallen angel, which this catalogue records for study and never
   venerates. Those take `awaiting`, the neutral cross-less ground the
   not-yet-glorified witnesses already use. */
const venerated = h.entityType !== "Fallen" && !isBiblicalEncounter(h);

/* Hero portrait — a validated open-license icon when one exists, else the
   arched monogram, crossed or neutral per the above. */
const portrait = h.image
  ? `<div class="sv-icon-img" style="background:#16304c center top/cover no-repeat url('${withBase(h.image)}')"></div>`
  : saintAvatar({ name: h.name }, 286, 358, { awaiting: !venerated });

/* Feast card. Hosts hold plain fixed "Mon D" tokens (nearly all Nov 8, the
   Synaxis of the Bodiless Powers), so the New/Old pair is computed directly
   rather than through the saint feast parser. */
const MONTHS = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
function oldStyle(token: string): string {
  const m = /^([A-Za-z]{3})[a-z]*\s+(\d{1,2})$/.exec(token.trim());
  if (!m) return "";
  const month = MONTHS.indexOf(m[1]) + 1;
  if (month < 1) return "";
  const oc = oldCalendarDay(month, Number(m[2]));
  return `${MONTHS[oc.month - 1]} ${oc.day}`;
}
const feastNew = h.feasts?.[0] ?? "";
const feastOld = feastNew ? oldStyle(feastNew) : "";
const furtherFeasts = (h.feasts ?? []).slice(1);

/* Rail "At a glance" — the catalogue facts, in the saint page's dl shape. */
const railFacts: [string, string][] = [
  ["Entity type", h.entityType],
  ...(h.order && h.order !== h.entityType
    ? ([["Celestial order", h.order]] as [string, string][])
    : []),
  ...(h.triad ? ([["Triad", `${h.triad} Triad`]] as [string, string][]) : []),
  ["Canonical status", h.canonicalStatus],
  ...(h.primarySource
    ? ([["Primary source", h.primarySource]] as [string, string][])
    : []),
];

/* Source registers, kept apart in the rail exactly as §5b requires. */
const refBlocks = [
  { label: "Holy Scripture", items: h.scripture },
  { label: "Deuterocanonical", items: h.deuterocanonical },
  { label: "Extra-Biblical", items: h.extraBiblical },
].filter((b) => b.items && b.items.length) as {
  label: string;
  items: string[];
}[];

/* Cross-links from the catalogue row (ids) — the curated `related` list with
   notes is a main-column section instead. */
const crossLinks = [
  {
    label: "Related Beings",
    items: (h.relatedBeings ?? []).map((id) => ({
      href: `host/${id}`,
      name: hostById.get(id)?.name ?? id,
    })),
  },
  {
    label: "Related Saints",
    items: (h.relatedSaints ?? []).map((id) => ({
      href: `saint/${id}`,
      name: saintById.get(id)?.name ?? id,
    })),
  },
  {
    label: "Related Feasts",
    items: (h.relatedFeasts ?? []).map((id) => ({
      href: `feast/${id}`,
      name: feastById.get(id)?.name ?? id,
    })),
  },
].filter((b) => b.items.length);

/* The dossier's Main Content axes, retitled in plain language. The field names
   are the archive's ("Orthodox Interpretation", "Historical Influence"); a
   visitor who came to find out what a guardian angel is should not have to
   decode them to guess what is behind each row. The catalogue view keeps the
   formal titles. */
const proseBlocks: { heading: string; body: string[] }[] = [];
if (p) {
  if (p.historicalContext?.length)
    proseBlocks.push({
      heading: "How it reached us",
      body: p.historicalContext,
    });
  if (p.orthodoxInterpretation?.length)
    proseBlocks.push({
      heading: "What the Fathers taught",
      body: p.orthodoxInterpretation,
    });
  if (p.liturgicalTradition?.length)
    proseBlocks.push({
      heading: "In the Church’s services",
      body: p.liturgicalTradition,
    });
  if (p.iconography?.length)
    proseBlocks.push({
      heading: "How it is shown in icons",
      body: p.iconography,
    });
  if (p.historicalInfluence?.length)
    proseBlocks.push({
      heading: "Its mark on Orthodox life",
      body: p.historicalInfluence,
    });
}

/* The page leads with the question chips and the essentials cards. When a
   profile carries neither, there is nothing above the fold to answer with, so
   the full teaching opens by default rather than leaving an empty column. */
const leadWithProse = !p?.faq?.length && !p?.salvationHistory?.length;

const citation = `${h.name} — Cloud of Witnesses.`;
const depImg = (src: string) =>
  /^(https?:)?\/\//.test(src) ? src : withBase(src);
---

<div class="saintview sv2" id="host-detail">
  {/* ══════════════ HERO ══════════════ */}
  <section class="sv-hero">
    <div class="sv-hero-inner">
      <nav class="sv-hero-crumb" aria-label="Breadcrumb">
        <a href={withBase(backHref)} class="sv-back-link">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M14 6l-6 6 6 6"></path></svg
          >
          <span class="sv-back-label">{backLabel}</span>
        </a>
        <span class="sv-sep">/</span>
        <span class="sv-here">{h.name}</span>
      </nav>

      <div class="sv-hero-grid">
        <div class="sv-hero-icon">
          <div class="sv-icon-frame">
            <div class="sv-icon-inner" set:html={portrait} />
          </div>
          {
            h.image ? (
              h.imagePermission ? (
                <div class="sv-icon-cap">
                  {h.imageAttribution}
                  {h.imageSource && (
                    <>
                      {" "}
                      Original icon:{" "}
                      <a
                        href={h.imageSource}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        View on {h.imageVendor}
                      </a>
                    </>
                  )}
                </div>
              ) : (
                <div class="sv-icon-cap">
                  <span class="sv-icon-cap-eb">Icon</span> ·{" "}
                  {h.imageSource ? (
                    <a
                      href={h.imageSource}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {h.imageCredit || "source"}
                    </a>
                  ) : (
                    h.imageCredit
                  )}
                  {h.imageLicense && (
                    <span class="sv-icon-lic">{h.imageLicense}</span>
                  )}
                </div>
              )
            ) : (
              /* "Icon forthcoming" is a promise, and for a fallen being it is
                 one the Church will never keep — no icon of a demon is written
                 for veneration (§9). Scriptural episodes keep the caption: the
                 Annunciation and Jacob's Ladder are classic icon subjects. */
              h.entityType !== "Fallen" && (
                <div class="sv-icon-cap">Icon forthcoming</div>
              )
            )
          }
        </div>

        <div class="sv-hero-id">
          <div class="sv-hero-tagrow">
            <span
              class:list={[
                "tag",
                "sv-tag-gold",
                "hsv-typetag",
                { "hsv-typetag--fallen": h.entityType === "Fallen" },
              ]}><i></i>{h.entityType}</span
            >
            <span class="eyebrow on-blue">Heavenly Hosts</span>
          </div>

          <h1 class="sv-name">{h.name}</h1>
          {
            h.aka?.length && (
              <div class="sv-also">Also known as {h.aka.join(" · ")}</div>
            )
          }

          <div class="sv-hero-rule"></div>

          {h.brief && <p class="sv-lead">{h.brief}</p>}
        </div>
      </div>

      {
        feastNew && (
          <div class="sv-fday">
            <div class="sv-fday-body">
              <div class="sv-fday-primary">
                <div class="sv-fday-cal sv-fday-cal--new">
                  <span class="sv-fday-date">{feastNew}</span>
                  {feastOld && <span class="sv-fday-cap">New Calendar</span>}
                </div>
                <div class="sv-fday-top">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--gold-soft)"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M3 9h18M8 3v4M16 3v4" />
                  </svg>
                  <span class="sv-fday-label">Commemorated</span>
                </div>
                {feastOld && (
                  <div class="sv-fday-cal sv-fday-cal--old">
                    <span class="sv-fday-date sv-fday-date--old">
                      {feastOld}
                    </span>
                    <span class="sv-fday-cap">Old Calendar</span>
                  </div>
                )}
              </div>
              {furtherFeasts.length > 0 && (
                <div class="sv-fday-more">
                  <span class="sv-fday-more-label">Also</span>
                  <ul class="sv-fday-more-list">
                    {furtherFeasts.map((f) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {/* ══════════════ ACTIONS RIBBON ══════════════ */}
  <div class="sv-actions">
    <div class="sv-actions-inner">
      {
        /* sv-correct-link, not sv-explore-link: only the former has the
          ribbon override that turns the pill ivory-on-gold. The explore
          treatment is for the separate resources bar, and reads washed out
          against this gold ground. */
      }
      <a href={withBase("nine-orders")} class="btn btn--ghost sv-correct-link">
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--celest)"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3l8 5-8 5-8-5 8-5Z"></path>
          <path d="M4 13l8 5 8-5"></path>
        </svg>
        <span class="sv-correct-label">The Nine Orders</span>
      </a>
      <div class="sv-actions-spacer"></div>
      <a
        href={withBase("corrections?subject=" + encodeURIComponent(h.name))}
        class="btn btn--ghost sv-correct-link"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--celest)"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
        <span class="sv-correct-label">Suggest a correction</span>
      </a>
      <button type="button" class="btn btn--gold sv-share" data-cite={citation}>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--byz-ink)"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
        </svg>
        <span class="sv-share-label">Share / cite</span>
      </button>
    </div>
  </div>

  {
    /* ══════════════ MEMBERS OF THIS RANK ══════════════
      A rank that owns named angels (the Archangels) leads with its roster:
      whoever lands on "the Archangels" is usually looking for Michael or
      Gabriel, so the way through to them comes before the essay about the
      order itself. */
  }
  {
    members.length > 0 && (
      <section class="hsv-members" aria-label={`The holy ${h.name}`}>
        <div class="hsv-members-inner">
          <div class="sv-secthead">
            <span class="eyebrow">The Holy {h.name}</span>
          </div>
          <div class="hsv-member-grid">
            {members.map((m) => (
              <a class="hsv-member" href={withBase(`host/${m.id}`)}>
                <span class="hsv-member-thumb">
                  {m.imageThumb || m.image ? (
                    <img
                      src={withBase(m.imageThumb || m.image!)}
                      alt={m.name}
                      loading="lazy"
                    />
                  ) : (
                    <span class="hsv-member-mono" aria-hidden="true">
                      {shortName(m.name).charAt(0)}
                    </span>
                  )}
                </span>
                <span class="hsv-member-name">{shortName(m.name)}</span>
                <span class="hsv-member-brief">{m.brief}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* ══════════════ DEPICTIONS ══════════════ */}
  {
    h.depictions && h.depictions.length > 0 && (
      <section class="sv-deps" aria-label="Depictions and icons">
        <div class="sv-deps-inner">
          <div class="sv-deps-head">
            <div class="sv-deps-headings">
              <div class="eyebrow sv-deps-eb">Depictions &amp; Icons</div>
              <p class="sv-deps-sub">
                How the Church has written this image — museum masters,
                hand-painted commissions, and icons you can order today.
              </p>
            </div>
          </div>
          <div class="sv-deps-viewport">
            <div class="sv-deps-track">
              {h.depictions.map((d) => {
                const inner = (
                  <>
                    <div class="sv-dep-frame">
                      <div class="sv-dep-mat">
                        <div
                          class="sv-dep-img"
                          style={`background-image:url('${depImg(d.image)}')`}
                        />
                      </div>
                    </div>
                    <div class="sv-dep-meta">
                      {d.tag && (
                        <span class={`sv-dep-tag sv-dep-tag--${d.kind}`}>
                          {d.tag}
                        </span>
                      )}
                      <div class="sv-dep-title">
                        {d.title}
                        {d.era && <span class="sv-dep-era"> · {d.era}</span>}
                      </div>
                      {(d.by || d.attribution) && (
                        <div class="sv-dep-by">
                          <span>{d.attribution || d.by}</span>
                        </div>
                      )}
                    </div>
                  </>
                );
                return d.source ? (
                  <a
                    href={d.source}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="sv-dep sv-dep--link"
                  >
                    {inner}
                  </a>
                ) : (
                  <div class="sv-dep">{inner}</div>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* ══════════════ BODY ══════════════ */}
  <div class="sv-body">
    <aside class="sv-rail">
      <div class="sv-glance">
        <div class="eyebrow">At a glance</div>
        <dl>
          {
            railFacts.map(([k, v]) => (
              <div class="sv-fact">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {
        /* Reference apparatus, folded away. Left open these ran the full height
          of the page — three scripture registers plus a sixteen-entry list of
          related beings — which is a wall of citations for a reader who came to
          find out what a guardian angel is. Each keeps its count so the depth is
          still advertised; Holy Scripture stays open as the one a visitor is
          most likely to actually want. */
      }
      {
        refBlocks.map((b, i) => (
          <details class="hsv-aside" open={i === 0}>
            <summary>
              <span class="eyebrow">{b.label}</span>
              <span class="hsv-aside-ct">{b.items.length}</span>
            </summary>
            <ul class="hsv-aside-list">
              {b.items.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </details>
        ))
      }

      {
        crossLinks.map((b) => (
          <details class="hsv-aside">
            <summary>
              <span class="eyebrow">{b.label}</span>
              <span class="hsv-aside-ct">{b.items.length}</span>
            </summary>
            <ul class="hsv-aside-list hsv-aside-links">
              {b.items.map((it) => (
                <li>
                  <a href={withBase(it.href)}>{it.name}</a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </aside>

    <main class="sv-main">
      {
        p && p.status !== "reviewed" && (
          <div class={`hsv-notice hsv-notice--${p.status}`}>
            <strong>
              {p.status === "flagged" ? "Flagged draft" : "Draft"}
            </strong>{" "}
            — this profile is unreviewed and not yet published. Shown here for
            review.
            {p.status === "flagged" && p.flagReasons?.length && (
              <ul>
                {p.flagReasons.map((f) => (
                  <li>
                    <strong>{f.claim}</strong> — {f.detail}
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }

      {
        !p && (
          <p class="hsv-stub">
            No rich profile yet — this entry carries its catalogue record only.
          </p>
        )
      }

      {
        /* ── Ask-first: the questions a visitor actually arrives with. Each chip
             opens the matching Q&A below and scrolls to it. ── */
      }
      {
        p?.faq?.length && (
          <section class="hsv-ask">
            <div class="sv-secthead">
              <span class="eyebrow">What do you want to know?</span>
            </div>
            <div class="hsv-chips">
              {p.faq.map((f, i) => (
                <button type="button" class="hsv-chip" data-q={String(i)}>
                  {f.question}
                </button>
              ))}
            </div>
          </section>
        )
      }

      {
        /* ── The essentials, as cards: the shortest honest answer to "what is
             this actually about", each opening in place for the full text. ── */
      }
      {
        p?.salvationHistory?.length && (
          <section class="hsv-ess">
            <div class="sv-secthead">
              <span class="eyebrow">
                {p.essentialsHeading || "The essentials"}
              </span>
            </div>
            <div class="hsv-cards">
              {p.salvationHistory.map((s) => (
                <details class="hsv-card">
                  <summary>
                    <span class="hsv-card-h">{s.heading}</span>
                    <p class="hsv-card-teaser">{s.body[0]}</p>
                    <span class="hsv-card-more" aria-hidden="true" />
                  </summary>
                  {s.body.slice(1).map((para) => (
                    <p class="hsv-card-rest">{para}</p>
                  ))}
                </details>
              ))}
            </div>
          </section>
        )
      }

      <div class="sv-after">
        <div class="sv-after-inner">
          {
            /* Reader-priority order: their own question first, then the words the
              Church prays, then the full teaching, then the apparatus. */
          }
          {
            p?.faq?.length && (
              <DeepSection
                heading={"Questions & Answers"}
                count={p.faq.length}
                showLabel="Show"
              >
                <div class="hsv-qa-list">
                  {p.faq.map((f, i) => (
                    <details class="hsv-qa" id={`qa-${i}`}>
                      <summary>{f.question}</summary>
                      <div class="hsv-qa-body">
                        {f.answer.map((para) => (
                          <p>{para}</p>
                        ))}
                      </div>
                    </details>
                  ))}
                </div>
              </DeepSection>
            )
          }

          {
            p?.prayers?.length && (
              <DeepSection
                heading="In the Church’s Prayer"
                count={p.prayers.length}
              >
                {p.prayers.map((pr) => (
                  <figure class="hsv-pryr">
                    <figcaption class="hsv-pryr-head">
                      <span class="hsv-pryr-title">{pr.title}</span>
                      {pr.use && <span class="hsv-pryr-use">{pr.use}</span>}
                    </figcaption>
                    <blockquote class="hsv-pryr-text">
                      {pr.text.map((para) => (
                        <p>{para}</p>
                      ))}
                    </blockquote>
                    <p class="hsv-pryr-attr">
                      {pr.source ? (
                        <a
                          href={pr.source}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {pr.translation}
                        </a>
                      ) : (
                        pr.translation
                      )}
                    </p>
                  </figure>
                ))}
              </DeepSection>
            )
          }

          {
            p?.overview?.length && (
              <DeepSection heading="The teaching in full" open={leadWithProse}>
                {p.overview.map((para) => (
                  <p class="sv-bodytext">{para}</p>
                ))}
              </DeepSection>
            )
          }

          {
            /* Two grouped bands instead of a dozen sibling rows. Left flat, the
              collapsed headers read as a filing cabinet; the reader-facing three
              above (questions, prayers, the teaching) get lost among them. */
          }
          {
            (proseBlocks.length > 0 || p?.sections?.length) && (
              <DeepSection
                heading="Go deeper"
                count={proseBlocks.length + (p?.sections?.length ?? 0)}
                showLabel="Show"
              >
                {proseBlocks.map((blk) => (
                  <details class="hsv-sub">
                    <summary>{blk.heading}</summary>
                    <div class="hsv-sub-body">
                      {blk.body.map((para) => (
                        <p>{para}</p>
                      ))}
                    </div>
                  </details>
                ))}
                {p?.sections?.map((sec) => (
                  <details class="hsv-sub">
                    <summary>{sec.heading}</summary>
                    <div class="hsv-sub-body">
                      {sec.body.map((para) => (
                        <p>{para}</p>
                      ))}
                    </div>
                  </details>
                ))}
              </DeepSection>
            )
          }

          {
            (p?.scripture?.length ||
              p?.authorities?.length ||
              p?.reading?.length) && (
              <DeepSection heading="Where this comes from" showLabel="Show">
                {p?.scripture?.length && (
                  <details class="hsv-sub">
                    <summary>
                      The Scripture passages
                      <span class="hsv-sub-ct">{p.scripture.length}</span>
                    </summary>
                    <div class="hsv-sub-body">
                      <ul class="hsv-refs">
                        {p.scripture.map((sc) => (
                          <li>
                            <strong>{sc.ref}</strong>
                            {sc.note ? ` — ${sc.note}` : ""}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                )}

                {p?.authorities?.length && (
                  <details class="hsv-sub">
                    <summary>Sources by authority</summary>
                    <div class="hsv-sub-body">
                      <p class="hsv-auth-lede">
                        Orthodox teaching is not one undifferentiated body of
                        claims. What Scripture states, what the Church prays,
                        what the Fathers taught, and what later writers explain
                        are distinct registers — this page keeps them apart so
                        you can see what each statement rests on.
                      </p>
                      <div class="hsv-auth-scroll">
                        <table class="hsv-auth">
                          <thead>
                            <tr>
                              <th scope="col">Register</th>
                              <th scope="col">Sources</th>
                            </tr>
                          </thead>
                          <tbody>
                            {p.authorities.map((a) => (
                              <tr>
                                <th scope="row">
                                  {a.level}
                                  {a.note && (
                                    <span class="hsv-auth-note">{a.note}</span>
                                  )}
                                </th>
                                <td>{a.sources.join("; ")}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </details>
                )}

                {p?.reading?.length && (
                  <details class="hsv-sub">
                    <summary>Read more</summary>
                    <div class="hsv-sub-body">
                      {p.reading.map((r) => (
                        <div class="hsv-reading">
                          <h3>{r.heading}</h3>
                          <ul>
                            {r.items.map((it) => (
                              <li>
                                {it.url ? (
                                  <a
                                    href={it.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                  >
                                    {it.title}
                                  </a>
                                ) : (
                                  it.title
                                )}
                                {it.author ? ` — ${it.author}` : ""}
                                {it.type ? ` (${it.type})` : ""}
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </details>
                )}
              </DeepSection>
            )
          }

          {
            h.notes && (
              <div class="hsv-fineprint">
                <div class="eyebrow">Catalogue note</div>
                <p>{h.notes}</p>
              </div>
            )
          }

          {
            h.sources?.length && (
              <div class="hsv-sources">
                <div class="eyebrow">Catalogue sources</div>
                <p>{h.sources.join("; ")}</p>
              </div>
            )
          }
        </div>
      </div>
    </main>
  </div>
</div>

<style>
  /* The chrome (hero, feast card, actions ribbon, rail, deep-dives, depictions)
     reuses the global `.sv-*` saint-page system; only the host-specific bits
     are scoped here. */

  /* Entity-type chip in the hero tagrow — the sv-tag-gold treatment, tinted to
     the celestial blue rather than a saint's rank colour. */
  /* A fallen being is catalogued for study, never venerated (§9). It should not
     wear the same gold chip as the holy powers. */
  .hsv-typetag--fallen {
    background: rgba(141, 58, 47, 0.3) !important;
    border-color: rgba(214, 160, 150, 0.5) !important;
  }
  .hsv-typetag {
    background: rgba(90, 127, 166, 0.22);
    border-color: rgba(230, 205, 126, 0.45);
    color: var(--ivory);
  }

  /* Rail blocks — the source registers and cross-links, matching .sv-glance.
     Collapsible, so the apparatus does not out-run the page it annotates. */
  .hsv-aside {
    margin-top: 1.1rem;
    border-top: 1px solid rgba(128, 128, 128, 0.18);
    padding-top: 0.7rem;
  }
  .hsv-aside > summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hsv-aside > summary::-webkit-details-marker {
    display: none;
  }
  .hsv-aside > summary::after {
    content: "+";
    margin-left: auto;
    color: var(--gold-deep);
    font-weight: 700;
  }
  .hsv-aside[open] > summary::after {
    content: "\2212";
  }
