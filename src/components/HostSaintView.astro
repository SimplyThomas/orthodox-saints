  .hsv-card {
    border: 1px solid rgba(128, 128, 128, 0.24);
    border-left: 3px solid var(--line-gold);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.4);
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .hsv-card[open],
  .hsv-card:hover {
    border-left-color: var(--gold-deep);
    box-shadow: var(--shadow-card);
  }
  /* An opened card takes the full grid width: these paragraphs are long, and a
     one-column card turns them into a tall ribbon of text. Auto-placement gives
     it its own row and keeps the reading order. */
  .hsv-card[open] {
    grid-column: 1 / -1;
  }
  .hsv-card > summary {
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 1.3rem;
  }
  .hsv-card > summary::-webkit-details-marker {
    display: none;
  }
  .hsv-card-h {
    display: block;
    font-family: var(--serif);
    font-size: 1.14rem;
    font-weight: 600;
    color: var(--byz-deep);
    line-height: 1.25;
  }
  .hsv-card-teaser {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .hsv-card:not([open]) .hsv-card-teaser {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* The +/− affordance, so a card reads as openable at a glance. */
  .hsv-card-more::after {
    content: "+";
    position: absolute;
    top: 0;
    right: 0;
    font-weight: 700;
    color: var(--gold-deep);
