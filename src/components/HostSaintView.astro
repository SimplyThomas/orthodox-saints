  .hsv-refs {
    padding-left: 1.1rem;
    margin: 0;
  }
  .hsv-refs li {
    margin-bottom: 0.45rem;
    line-height: 1.55;
  }

  /* One nested-row treatment, shared by the Q&A answers and by the sub-sections
     inside the "Go deeper" / "Where this comes from" bands: a quiet +/- row,
     visually subordinate to the gold sv-deep headers above it. */
  .hsv-qa,
  .hsv-sub {
    border-top: 1px solid rgba(128, 128, 128, 0.18);
  }
  /* `.sv2 .sv-deep > :not(summary)` gives every nested block a 24px top margin,
     which spreads these into a sparse ladder. Keep that gap under the section
     header (the first row) and close it between rows — they are one list. Needs
     the `.sv2` prefix to out-specify the global rule. */
  .sv2 .hsv-qa + .hsv-qa,
  .sv2 .hsv-sub + .hsv-sub {
    margin-top: 0;
