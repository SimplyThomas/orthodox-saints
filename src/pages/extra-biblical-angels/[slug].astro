<script>
  /* Share / cite — mirrors the saint, witness and host pages. */
  const share = document.querySelector<HTMLButtonElement>(".sv-share");
  const shareLabel = share?.querySelector<HTMLElement>(".sv-share-label");
  if (share && shareLabel) {
    const cite = share.dataset.cite || document.title;
    const url = location.href;
    share.addEventListener("click", async () => {
      try {
        if (navigator.share) {
          await navigator.share({ title: cite, url });
          return;
        }
        await navigator.clipboard.writeText(`${cite} ${url}`);
        const prev = shareLabel.textContent;
        shareLabel.textContent = "Citation copied";
        window.setTimeout(() => {
          shareLabel.textContent = prev;
        }, 1600);
      } catch {
        /* dismissed or clipboard denied — no-op */
      }
    });
  }

  /* The kind cards are a switch, not a link. Selecting one swaps the panel
     directly beneath them — the reader stays where they are. Progressive
     enhancement: until this runs, `is-live` is absent and every panel is
     visible, so the content is reachable with no JS at all. */
  const panels = document.querySelector<HTMLElement>(".wk-panels");
  const cards = [...document.querySelectorAll<HTMLButtonElement>(".wk-kind")];
  if (panels && cards.length) {
    const show = (key: string) => {
      for (const card of cards) {
        card.setAttribute("aria-selected", String(card.dataset.kind === key));
      }
      for (const panel of panels.querySelectorAll<HTMLElement>(".wk-panel")) {
        panel.hidden = panel.dataset.kind !== key;
      }
    };
    panels.classList.add("is-live");
    show(cards[0].dataset.kind!);
    for (const card of cards) {
      card.addEventListener("click", () => show(card.dataset.kind!));
    }
  }
</script>
