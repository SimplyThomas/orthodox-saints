---
import type { GetStaticPaths } from "astro";
import { loadWorks } from "../../lib/apocrypha";
import { hostById } from "../../lib/hosts";
import { withBase } from "../../lib/format";
import { saintAvatar } from "../../lib/icons";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DeepSection from "../../components/DeepSection.astro";
import EntryCard from "../../components/EntryCard.astro";

export const getStaticPaths = (async () => {
  const works = await loadWorks();
  return works.map((w) => ({ params: { slug: w.slug }, props: { work: w } }));
}) satisfies GetStaticPaths;

const { work: w } = Astro.props;

const overview = w.overview ?? [];
const sections = w.sections ?? [];
const collections = w.collections ?? [];

function slugify(s: string): string {
  return s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}
const isExternal = (href: string) => /^https?:\/\//.test(href);
const resolve = (href: string) => (isExternal(href) ? href : withBase(href));

// An entry links to its host record (HH-####) first, else a related href.
function entryHref(e: { hostId?: string; relatedHref?: string }) {
  if (e.hostId) return withBase(`host/${e.hostId}`);
  if (e.relatedHref) return resolve(e.relatedHref);
  return null;
}
function entryThumb(hostId?: string): string | null {
  if (!hostId) return null;
  const h = hostById.get(hostId);
  const rel = h?.imageThumb || h?.image;
  return rel ? withBase(rel) : null;
}
function entryBlurb(e: {
  blurb?: string;
  role?: string[];
  summary?: string[];
  body?: string[];
}): string | undefined {
  return e.blurb ?? e.body?.[0] ?? e.role?.[0] ?? e.summary?.[0];
}
function entryBody(e: {
  body?: string[];
  summary?: string[];
  role?: string[];
}): string[] {
  return e.body ?? e.summary ?? e.role ?? [];
}

/* A book is not a person and is never venerated (§9), so the placeholder takes
   saintAvatar's cross-less `awaiting` ground — the same rule the Biblical
   Encounters and the fallen beings follow on the host pages. */
const portrait = saintAvatar({ name: w.title }, 286, 358, { awaiting: true });

/* "How many beings of this kind" — the count each card advertises. A table-mode
   directory carries its members as table rows rather than entries. */
const kindCount = (c: (typeof collections)[number]) =>
  c.entries?.length || c.table?.rows?.length || 0;

/* The catalogued-never-venerated note appears once, on the first fallen
   directory, rather than being repeated on each. */
const firstFallenKey = collections.find((c) => c.tone === "fallen")?.key;

const railFacts: [string, string][] = [
  ...(w.era ? ([["Era", w.era]] as [string, string][]) : []),
  ...(w.canonicalStatus
    ? ([["Status", w.canonicalStatus]] as [string, string][])
    : []),
  ["Directories", String(collections.length)],
];

const citation = `${w.title} — Cloud of Witnesses.`;
---

<BaseLayout title={w.title} description={w.blurb} ogType="article">
  <div class="saintview sv2" id="work-detail">
    {/* ══════════════ HERO ══════════════ */}
    <section class="sv-hero">
      <div class="sv-hero-inner">
        <nav class="sv-hero-crumb" aria-label="Breadcrumb">
          <a href={withBase("extra-biblical-angels")} class="sv-back-link">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M14 6l-6 6 6 6"></path></svg
            >
            <span class="sv-back-label">Extra-Biblical Angels</span>
          </a>
          <span class="sv-sep">/</span>
          <span class="sv-here">{w.title}</span>
        </nav>

        <div class="sv-hero-grid">
          <div class="sv-hero-icon">
            <div class="sv-icon-frame">
              <div class="sv-icon-inner" set:html={portrait} />
            </div>
            <div class="sv-icon-cap">
              {w.era ? w.era : "Early Christian literature"}
            </div>
          </div>

          <div class="sv-hero-id">
            <div class="sv-hero-tagrow">
              {
                w.canonicalStatus && (
                  <span class="tag sv-tag-gold wk-statustag">
                    <i />
                    {w.canonicalStatus}
                  </span>
                )
              }
              <span class="eyebrow on-blue">Heavenly Hosts</span>
            </div>

            <h1 class="sv-name">{w.title}</h1>
            {
              w.aka?.length && (
                <div class="sv-also">Also known as {w.aka.join(" · ")}</div>
              )
            }

            <div class="sv-hero-rule"></div>

            <p class="sv-lead">{w.blurb}</p>
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════ ACTIONS RIBBON ══════════════ */}
    <div class="sv-actions">
      <div class="sv-actions-inner">
        <a
          href={withBase("extra-biblical-angels")}
          class="btn btn--ghost sv-correct-link"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--celest)"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path
              d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"
            ></path>
          </svg>
          <span class="sv-correct-label">All the books</span>
        </a>
        <div class="sv-actions-spacer"></div>
        <a
          href={withBase("corrections?subject=" + encodeURIComponent(w.title))}
          class="btn btn--ghost sv-correct-link"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--celest)"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
          </svg>
          <span class="sv-correct-label">Suggest a correction</span>
        </a>
        <button
          type="button"
          class="btn btn--gold sv-share"
          data-cite={citation}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--byz-ink)"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
          </svg>
          <span class="sv-share-label">Share / cite</span>
        </button>
      </div>
    </div>

    {
      /* ══════════════ THE KINDS OF BEING ══════════════
        The page's map AND its switch. One card per directory, in the shape the
        Archangels hub uses for its members — but these do not jump the reader
        down the page. Selecting a card swaps the panel directly beneath the
        cards, so the content arrives where the eye already is. Without JS every
        panel is simply open, one after another, and nothing is lost. */
    }
    {
      collections.length > 0 && (
        <section class="wk-kinds" aria-label="Beings of this book">
          <div class="wk-kinds-inner">
            <div class="sv-secthead">
              <span class="eyebrow">Who appears in this book</span>
            </div>

            <div class="wk-kind-grid" role="tablist">
              {collections.map((c, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${c.key}`}
                  class={`wk-kind wk-kind--${c.tone ?? "neutral"}`}
                  data-kind={c.key}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`panel-${c.key}`}
                >
                  <span class="wk-kind-top">
                    <span class="wk-kind-name">{c.navLabel ?? c.title}</span>
                    <span class="wk-kind-count">{kindCount(c)}</span>
                  </span>
                  <span class="wk-kind-blurb">{c.intro?.[0]}</span>
                </button>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      collections.length > 0 && (
        <section class="wk-panelwrap">
          <div class="wk-kinds-inner">
            <div class="wk-panels">
              {collections.map((c, i) => (
                <section
                  class="wk-panel"
                  id={`panel-${c.key}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${c.key}`}
                  data-kind={c.key}
                  data-first={i === 0 ? "true" : "false"}
                >
                  <h2 class="wk-panel-h">{c.title}</h2>
                  {c.intro?.map((p) => (
                    <p class="wk-intro">{p}</p>
                  ))}

                  {c.key === firstFallenKey && (
                    <p class="wk-warn">
                      Catalogued for study, never venerated (§9).
                    </p>
                  )}

                  {c.table && (
                    <div class="wk-tblwrap">
                      <table class="wk-tbl">
                        <thead>
                          <tr>
                            {c.table.columns.map((col) => (
                              <th scope="col">{col}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {c.table.rows.map((row) => (
                            <tr>
                              {row.map((cell) => (
                                <td>{cell}</td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}

                  {c.display === "cards" && c.entries.length > 0 && (
                    <div class="wk-cardgrid">
                      {c.entries.map((e) => (
                        <EntryCard
                          name={e.name}
                          meaning={e.meaning}
                          blurb={entryBlurb(e)}
                          href={entryHref(e)}
                          thumb={entryThumb(e.hostId)}
                        />
                      ))}
                    </div>
                  )}

                  {c.display !== "cards" && c.entries.length > 0 && (
                    <div class="wk-entries">
                      {c.entries.map((e) => (
                        <details class="wk-sub">
                          <summary>
                            {e.name}
                            {e.meaning && (
                              <span class="wk-meaning">{e.meaning}</span>
                            )}
                          </summary>
                          <div class="wk-sub-body">
                            {e.refs?.length && (
                              <p class="wk-refs">{e.refs.join(" · ")}</p>
                            )}
                            {entryBody(e).map((p) => (
                              <p>{p}</p>
                            ))}
                            {e.fate && (
                              <p class="wk-fate">
                                <strong>Fate.</strong> {e.fate}
                              </p>
                            )}
                            {e.lists?.map((l) => (
                              <div class="wk-list">
                                <span class="wk-list-label">{l.label}</span>
                                <ul>
                                  {l.items.map((it) => (
                                    <li>{it}</li>
                                  ))}
                                </ul>
                              </div>
                            ))}
                            {entryHref(e) && (
                              <p class="wk-more">
                                <a href={entryHref(e)!}>
                                  {e.relatedLabel ?? `More on ${e.name}`}
                                </a>
                              </p>
                            )}
                          </div>
                        </details>
                      ))}
                    </div>
                  )}

                  {c.outro?.map((p) => (
                    <p class="wk-outro">{p}</p>
                  ))}
                </section>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* ══════════════ BODY ══════════════ */}
    <div class="sv-body">
      <aside class="sv-rail">
        <div class="sv-glance">
          <div class="eyebrow">At a glance</div>
          <dl>
            {
              railFacts.map(([k, v]) => (
                <div class="sv-fact">
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        {
          w.browseTags?.length && (
            <div class="wk-aside">
              <div class="eyebrow">Themes</div>
              <div class="wk-tags">
                {w.browseTags.map((t) => (
                  <span class="wk-tag">{t}</span>
                ))}
              </div>
            </div>
          )
        }

        {
          w.relatedPages?.length && (
            <div class="wk-aside">
              <div class="eyebrow">Related</div>
              <ul class="wk-rel">
                {w.relatedPages.map((r) => (
                  <li>
                    {r.href ? <a href={resolve(r.href)}>{r.label}</a> : r.label}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>

      <main class="sv-main">
        {
          w.status !== "reviewed" && (
            <div class="wk-notice">
              <strong>
                {w.status === "flagged" ? "Flagged draft" : "Draft"}
              </strong>{" "}
              — this page is unreviewed and not yet published. Shown here for
              review.
            </div>
          )
        }

        <div class="sv-after">
          <div class="sv-after-inner">
            {
              /* The book itself — its story, folded so the directories above
                stay the first thing a reader meets. */
            }
            {
              overview.length > 0 && (
                <DeepSection heading="About the book" open={true}>
                  {overview.map((p) => (
                    <p class="sv-bodytext">{p}</p>
                  ))}
                </DeepSection>
              )
            }

            {
              sections.length > 0 && (
                <DeepSection
                  heading="The book in depth"
                  count={sections.length}
                  showLabel="Show"
                >
                  {sections.map((s) => (
                    <details class="wk-sub" id={slugify(s.heading)}>
                      <summary>{s.heading}</summary>
                      <div class="wk-sub-body">
                        {s.body?.map((p) => (
                          <p>{p}</p>
                        ))}
                        {s.table && (
                          <div class="wk-tblwrap">
                            <table class="wk-tbl">
                              <thead>
                                <tr>
                                  {s.table.columns.map((c) => (
                                    <th scope="col">{c}</th>
                                  ))}
                                </tr>
                              </thead>
                              <tbody>
                                {s.table.rows.map((row) => (
                                  <tr>
                                    {row.map((cell) => (
                                      <td>{cell}</td>
                                    ))}
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        )}
                      </div>
                    </details>
                  ))}
                </DeepSection>
              )
            }

            {
              w.sources?.length && (
                <DeepSection heading="Sources" showLabel="Show">
                  <ul class="wk-sources">
                    {w.sources.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </DeepSection>
              )
            }
          </div>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  /* Chrome (hero, ribbon, rail, deep-dives) reuses the global .sv-* saint-page
     system, exactly as the host pages do; only the work-specific bits are
     scoped here. */

  .sv-secthead .eyebrow {
    flex: 0 1 auto;
    min-width: 0;
  }

  .wk-statustag {
    background: rgba(90, 127, 166, 0.22);
    border-color: rgba(230, 205, 126, 0.45);
    color: var(--ivory);
  }

  /* ── The kinds-of-being cards ──────────────────────────────────────────
     A row of equal cards that select rather than navigate. Uniformity is the
     point: identical height whatever the blurb, the count as a quiet chip
     rather than a giant numeral, and a single active state. */
  /* The directory band is its own section: a full-bleed wash a shade cooler
     than the page, closed top and bottom by a hairline gold rule. It sets the
     whole "who appears in this book" area — cards and the panel they switch —
     apart from the prose that follows. */
  /* The selector strip is a deep-green band — the third in the page's stack,
     after the blue hero and the gold ribbon. Only the cards sit on the dark
     ground; the panel they switch drops below onto the page's own paper, so a
     table of twelve names is never read out of a dark field. */
  .wk-kinds {
    padding: clamp(22px, 3.4vw, 34px) 0 clamp(24px, 3.6vw, 36px);
    background: var(--ivory-3);
    border-top: 1px solid var(--line-gold);
    border-bottom: 1px solid var(--line-gold);
  }
  /* A tonal ladder in the existing ivory family rather than a new ground:
     the selector strip is the deepest cream (--ivory-3), the panel it opens sits
     a step lighter (--ivory-2), and the page's own paper resumes below. The two
     zones read as one section without introducing a colour the rest of the site
     does not use as a surface. */
  .wk-panelwrap {
    padding: clamp(22px, 3.2vw, 32px) 0 clamp(26px, 3.8vw, 38px);
    background: var(--ivory-2);
    border-bottom: 1px solid var(--line-gold);
  }
  /* Aligned to the body grid below, not to --maxw: `.sv2 .sv-body` is
     max-width 1280px and `.sv2 .sv-rail` pads clamp(22px, 3vw, 38px), so the
     cards share a left edge with the rail beneath them. Changing either means
     changing both. */
  .wk-kinds-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(22px, 3vw, 38px);
  }
  .wk-kind-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.7rem;
    margin-top: 0.9rem;
  }
  .wk-kind {
    /* the card is a button — strip the UA chrome, keep the box */
    font: inherit;
    text-align: left;
    cursor: pointer;
    appearance: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    /* equal height regardless of blurb length */
    min-height: 6.4rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid rgba(120, 100, 60, 0.22);
    border-top: 3px solid var(--line-gold);
    border-radius: 9px;
    /* The site's green ground (the monastic monogram colour in lib/icons.ts),
       lightened so a card still lifts off the green band behind it. */
    background: var(--paper);
    color: inherit;
    transition:
      border-color 0.15s,
      background 0.15s,
      box-shadow 0.15s,
      transform 0.1s;
  }
  .wk-kind:hover {
    border-color: var(--gold-deep);
    box-shadow: var(--shadow-card);
    transform: translateY(-1px);
  }
  .wk-kind:focus-visible {
    outline: 2px solid var(--byz);
    outline-offset: 2px;
  }
  .wk-kind[aria-selected="true"] {
    background: #fffdf7;
    border-color: var(--gold-deep);
    border-top-color: var(--gold-deep);
    box-shadow: var(--shadow-card);
  }
  /* A fallen directory is marked, not gilded (§9). */
  .wk-kind--fallen {
    border-top-color: rgba(141, 58, 47, 0.45);
  }
  .wk-kind--fallen[aria-selected="true"] {
    background: #fffdf7;
    border-color: rgba(141, 58, 47, 0.55);
    border-top-color: #8d3a2f;
  }
  .wk-kind-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .wk-kind-name {
    font-family: var(--serif);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--byz-deep);
  }
  .wk-kind-count {
    flex: none;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.24rem 0.46rem;
    border-radius: 999px;
    background: rgba(168, 133, 42, 0.16);
    color: var(--gold-deep);
  }
  .wk-kind--fallen .wk-kind-count {
    background: rgba(141, 58, 47, 0.14);
    color: #8d3a2f;
  }
  .wk-kind-blurb {
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── The panel the cards switch ── */
  .wk-panels {
    margin-top: 0;
  }
  .wk-panel-h {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--byz-deep);
    margin: 0 0 0.7rem;
  }
  /* Only the selected panel shows once the script has run. Before that (and
     with JS off) every panel is visible, so nothing is unreachable. */
  .wk-panels.is-live .wk-panel[hidden] {
    display: none;
  }
  .wk-panels.is-live .wk-panel {
    animation: wk-fade 0.22s ease-out;
  }
  @keyframes wk-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wk-panels.is-live .wk-panel {
      animation: none;
    }
    .wk-kind {
      transition: none;
    }
  }

  /* ── Rail extras ── */
  .wk-aside {
    margin-top: 1.4rem;
  }
  .wk-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
    margin-top: 0.55rem;
  }
  .wk-tag {
    font-size: 0.72rem;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid rgba(128, 128, 128, 0.28);
    color: var(--ink-soft);
  }
  .wk-rel {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
  }
  .wk-rel li {
    padding: 0.26rem 0;
    border-bottom: 1px solid rgba(128, 128, 128, 0.14);
  }
  .wk-rel li:last-child {
    border-bottom: 0;
  }
  .wk-rel a {
    color: var(--byz);
    text-decoration: none;
  }
  .wk-rel a:hover {
    text-decoration: underline;
  }

  .wk-notice {
    border-left: 3px solid var(--gold-deep);
    background: rgba(212, 175, 55, 0.09);
    padding: 0.75rem 1rem;
    margin: 0 0 1.4rem;
    font-size: 0.92rem;
    line-height: 1.6;
    border-radius: 0 5px 5px 0;
  }

  /* ── Nested rows inside a deep-dive (same treatment as the host pages) ── */
  .wk-sub {
    border-top: 1px solid rgba(128, 128, 128, 0.18);
  }
  .wk-sub:first-of-type {
    border-top: 0;
  }
  .sv2 .wk-sub + .wk-sub {
    margin-top: 0;
  }
  .wk-sub > summary {
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--byz-deep);
    padding: 0.62rem 0;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    line-height: 1.45;
  }
  .wk-sub > summary::-webkit-details-marker {
    display: none;
  }
  .wk-sub > summary::before {
    content: "+";
    color: var(--gold-deep);
    font-weight: 700;
    flex: none;
  }
  .wk-sub[open] > summary::before {
    content: "\2212";
  }
  .wk-sub > summary:hover {
    color: var(--byz);
  }
