---
import { HOSTS, isFallen } from "../lib/hosts";
import { withBase } from "../lib/format";
import BaseLayout from "../layouts/BaseLayout.astro";
import DomeMark from "../components/icons/DomeMark.astro";
import EyebrowRule from "../components/EyebrowRule.astro";

// The Fallen — the hub. Membership is the "Fallen" Entity Type itself
// (isFallen), not a tag, so a record can never be fallen here and holy
// elsewhere; the same predicate excludes these beings from
// /biblical-encounters and points their breadcrumb back here. These pages
// exist for study and for the sober naming of what Scripture names — §9: they
// carry no liturgical address, no feast, and no invocation of any kind.
// HOSTS arrives sorted by hostlib._sort_key.
const fallen = HOSTS.filter(isFallen);

// Grouped by the register the being is actually known from, so a reader can
// see at a glance which names Scripture gives and which come from later Jewish
// literature — the section's standing source-fidelity commitment (§5b). A
// record files under the first group whose canonical status matches; anything
// else falls through to "Other".
const REGISTERS = [
  {
    title: "Named in Scripture",
    statuses: ["Scriptural"],
    note: "Adversaries the canonical Scriptures name outright.",
  },
  {
    title: "Named in the Deuterocanon",
    statuses: ["Deuterocanonical"],
    note: "Named in the books Orthodoxy reads as Scripture but the Hebrew canon does not.",
  },
  {
    title: "From Second Temple Literature",
    statuses: ["Apocryphal", "Traditional", "Symbolic"],
    note: "Known from Jewish writings outside the canon, which the Church never received as Scripture.",
  },
] as const;
const groups: { title: string; note: string; items: typeof fallen }[] =
  REGISTERS.map((r) => ({
    title: r.title,
    note: r.note,
    items: fallen.filter((h) =>
      (r.statuses as readonly string[]).includes(h.canonicalStatus),
    ),
  })).filter((g) => g.items.length > 0);
const ungrouped = fallen.filter(
  (h) => !groups.some((g) => g.items.includes(h)),
);
if (ungrouped.length > 0) {
  groups.push({ title: "Other", note: "", items: ungrouped });
}
---

<BaseLayout
  active="fallen-angels"
  title="The Fallen"
  description="The fallen angels named in Scripture and in the Second Temple writings — Satan, Legion, Asmodeus, the Watchers and their kind, catalogued for study and never venerated."
>
  <div class="wrap">
    <header class="hosts-hero">
      <div class="dome-bg" aria-hidden="true">
        <DomeMark w={460} color="var(--ink-soft)" />
      </div>
      <div class="hosts-hero-inner">
        <EyebrowRule label="Heavenly Hosts" />
        <h1 class="hosts-title">The Fallen</h1>
        <p class="hosts-lede">
          The angels who kept not their first estate — named, and no more than
          named.
        </p>
      </div>
    </header>

    <section class="fa-intro">
      <p class="intro-body">
        The Church has never taught that evil is a power set opposite God. The
        fallen are creatures — angels who were made good and turned, who retain
        their intelligence and their freedom and misuse both, and who remain at
        every moment wholly subject to the God they refused. Scripture names a
        few of them; the Jewish writings outside the canon name a great many
        more. They are gathered here so that a reader who meets a name in the
        Gospels, in the Apocalypse, or in the Book of Enoch can be told plainly
        where it comes from and what standing it has.
      </p>
      <p class="fa-warning">
        These records are catalogued for study and never for veneration. They
        carry no feast, no hymn, no icon, and no prayer. Nothing on these pages
        is an address to the beings described.
      </p>
    </section>

    {
      fallen.length === 0 && (
        <p class="empty">
          No records catalogued yet. Entries will appear here as they are added.
        </p>
      )
    }

    {
      groups.map((group) => (
        <section class="fa-group">
          <h2 class="fa-group-title">{group.title}</h2>
          {group.note && <p class="fa-group-note">{group.note}</p>}
          <div class="grid">
            {group.items.map((h) => (
              <a class="card" href={withBase(`host/${h.id}`)}>
                <span class="cthumb" aria-hidden="true">
                  <span class="cmono">{h.name.charAt(0)}</span>
                </span>
                <span class="cname">{h.name}</span>
                <span class="cmeta">{h.entityType}</span>
                <span class="cbrief">{h.brief}</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <p class="fa-foot">
      The twenty Watcher chiefs, the giants, and the rest of the Enochic
      material are catalogued on <a
        href={withBase("extra-biblical-angels/1-enoch")}
        >the Book of Enoch page</a
      >, with the same caution.
    </p>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
  }
  /* Page hero — the shared hub hero (dome mark, diamond-flanked eyebrow, serif
     title and lede), but rendered in ink rather than the royal blue and gold
     the holy angels carry. The restraint is the point: this section is marked,
     not adorned. */
  .hosts-hero {
    position: relative;
    text-align: center;
    padding: var(--hero-pad-top) 20px clamp(30px, 5vw, 52px);
    overflow: hidden;
  }
  .hosts-hero-inner {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
  }
  .hosts-title {
    font-family: var(--serif);
    font-size: var(--page-title-size);
    color: var(--ink);
    margin: 18px 0 0;
    line-height: 1.05;
  }
  .hosts-lede {
    font-family: var(--serif);
    font-size: var(--page-lede-size);
    color: var(--ink-soft);
    margin: 16px auto 0;
    max-width: 46ch;
  }
  .empty {
    font-style: italic;
    opacity: 0.7;
    margin-top: 2rem;
    text-align: center;
  }

  .fa-intro {
    max-width: 44rem;
    margin: 0 auto 0.5rem;
    text-align: center;
  }
  .intro-body {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }
  /* The standing §9 note. Set apart by a rule rather than a colour block so it
     reads as a caution, not a callout badge. */
  .fa-warning {
    margin: 1.5rem auto 0;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(128, 128, 128, 0.3);
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 40rem;
  }

  .fa-group {
    margin-top: 2.75rem;
  }
  .fa-group-title {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--ink-soft);
    text-align: center;
    margin: 0 0 0.35rem;
  }
  /* muted hairline — the holy-angel hubs use gold here */
  .fa-group-title::after {
    content: "";
    display: block;
    width: 3rem;
    height: 2px;
    margin: 0.6rem auto 0;
    background: var(--ink-soft);
    opacity: 0.4;
  }
  .fa-group-note {
    text-align: center;
    font-style: italic;
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0.55rem auto 0;
    max-width: 36rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr));
    gap: 0.9rem;
    margin-top: 1.5rem;
  }
  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.85rem;
    row-gap: 0.15rem;
    align-items: start;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      transform 0.1s;
  }
  .card:hover {
    border-color: var(--ink-soft);
    box-shadow: var(--shadow-card);
    transform: translateY(-1px);
  }
  /* No portrait is ever shown here (§9 — no icon of a demon is written), so the
     thumb is always the ashen monogram ground, never an <img>. */
  .cthumb {
    grid-row: 1 / 4;
    width: 4rem;
    height: 4rem;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: radial-gradient(120% 120% at 30% 15%, #3a3a3f, #1c1c20);
  }
  .cmono {
    font-family: var(--serif);
    font-size: 1.7rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .cname {
    grid-column: 2;
    align-self: end;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .cmeta {
    grid-column: 2;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.65;
  }
  .cbrief {
    grid-column: 2;
    font-size: 0.86rem;
    line-height: 1.4;
    opacity: 0.85;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fa-foot {
    text-align: center;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--ink-soft);
    margin: 2.5rem auto 0;
    max-width: 40rem;
  }
</style>
