---
/* About — the landing page.
   /about used to serve the Our Story article, which meant clicking "About"
   dropped a visitor into one essay with no sense of what else was there. Our
   Story now lives at /our-story and this page is the directory: what the
   project is, then a card for every informational page. Adding one is a card
   in `cards` below. */
import HubPage from "../components/HubPage.astro";
import type { HubCard } from "../components/HubPage.astro";
import { SAINTS } from "../lib/data";

const saintCount = SAINTS.length;

const cards: HubCard[] = [
  {
    label: "Our Story",
    href: "our-story",
    eyebrow: "How this began",
    blurb:
      "Why a searchable reference of the saints was worth building, and how it came to exist.",
  },
  {
    label: "Our Mission",
    href: "mission",
    eyebrow: "What this is for",
    blurb:
      "Who the database is meant to serve, and what it is deliberately not trying to be.",
  },
  {
    label: "Editorial Standards",
    href: "editorial-standards",
    eyebrow: "How entries are written",
    blurb:
      "The rules every entry is held to: what may be asserted, what must be sourced, and what is left blank rather than guessed.",
  },
  {
    label: "Sources & Methodology",
    href: "sources",
    eyebrow: "Where it comes from",
    blurb:
      "The synaxaria, service books, and scholarly works this reference is built from, and how they are reconciled.",
  },
  {
    label: "Contributors",
    href: "contributors",
    eyebrow: "Who has helped",
    blurb:
      "The people whose reading, correcting, and reviewing has shaped the database.",
  },
  {
    label: "Report a Correction",
    href: "corrections",
    eyebrow: "Found a mistake?",
    blurb:
      "Tell us and it gets fixed. No account needed — the form files the report directly.",
  },
  {
    label: "Contribute",
    href: "contribute",
    eyebrow: "Help build it",
    blurb:
      "How to add a saint, deepen a profile, or offer an icon the project may use.",
  },
  {
    label: "Contact",
    href: "contact",
    eyebrow: "Get in touch",
    blurb: "For questions, permissions, and anything the other pages missed.",
  },
  {
    label: "Privacy",
    href: "privacy",
    eyebrow: "What we collect",
    blurb:
      "Almost nothing. No accounts, no browser storage, no tracking of what you search for.",
  },
];
---

<HubPage
  active="about-hub"
  eyebrow="About the Project"
  title="About Orthodox Saint Finder"
  lede="An open, freely given reference of the saints and the Church calendar."
  description="About Orthodox Saint Finder — an open, freely given reference of the Orthodox saints and the Church calendar, and the standards it is held to."
  intro={[
    `Orthodox Saint Finder is a searchable reference of the canonical Eastern Orthodox saints — presently ${saintCount.toLocaleString()} of them — built so that anyone can find a patron, an intercessor, or simply a life worth reading. It is free, it carries no advertising, and it asks nothing of you: no account, no sign-in, and no record of what you look for.`,
    "It is also unfinished, and says so. Entries are cited, blanks are left blank rather than filled with guesses, and nothing here is offered as authoritative until competent clergy and sources have reviewed it. The pages below set out how that works — what the standards are, where the material comes from, and how to tell us when we have got something wrong.",
  ]}
  cards={cards}
/>
