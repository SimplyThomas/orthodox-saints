---
/* THE DAILY DOVE — the front page of The Living Archive.

   Set as a broadsheet front page, not as a feed of cards. The governing idea is
   that a visitor is unfolding today's sheet out of an archive that has been kept
   since Pentecost — so the page is ordered the way a paper is ordered, and its
   hierarchy is dramatic rather than even:

     nameplate → the front page proper (lead + secondaries + briefs + margin)
     → Also In This Edition → the latest dispatches at two weights → the
     departments → the archive → the eras → the topics → the Historian's Desk
     → and only then, folded shut at the foot, the key to how the paper is read.

   Three rules earn most of the effect and are easy to undo by accident:

   1. IT PRINTS ON NEWSPRINT. See the palette note in daily-dove-paper.css. The
      first build of this page used the site's navy as its ground, and every
      panel then needed a coloured fill to lift off it — which is precisely what
      made the page read as busy. On a pale stock the ground is the resting
      state and rules do the dividing.

   2. RESTRAINT IS THE FEATURE, NOT AN OVERSIGHT. Almost nothing here has a
      fill; the era entries are ruled lines rather than plates, the topics are a
      bare classified column, and there is one piece of ornament on the page
      (the headpiece under the nameplate). Each of those was tried the loud way
      first. If a section arrives wanting a coloured background, a badge and a
      flourish, it will cost the page more than it gains.

   3. NOT EVERYTHING IS A CARD, AND NO FILTER BAR LIVES HERE. The lead is a
      broadsheet block; the secondaries are ruled columns; the briefs are one
      line each. Faceted browsing lives at /daily-dove/archive, which is built
      for it — the era and topic sections link into it with a #<facet>-<value>
      hash the archive island honours.

   The page is fully static: the only interactive part is the key at the foot,
   which is a native <details>. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsMeta from "../../components/daily-dove/NewsMeta.astro";
import EraPill from "../../components/daily-dove/EraPill.astro";
import EvidenceDot from "../../components/daily-dove/EvidenceDot.astro";
import EvidenceKey from "../../components/daily-dove/EvidenceKey.astro";
import DoveMasthead from "../../components/daily-dove/DoveMasthead.astro";
import Headpiece from "../../components/daily-dove/ornament/Headpiece.astro";
import WaxSeal from "../../components/daily-dove/ornament/WaxSeal.astro";
import { withBase } from "../../lib/format";
import "../../styles/daily-dove-paper.css";
import {
  loadPaper,
  ord,
  postRank,
  eraOf,
  deskOf,
  FILING_DESKS,
  EVIDENCE,
  EVIDENCE_LIST,
  ERAS,
  WONDERS,
  DOVE_STANDFIRST,
  NEWS_THISDAY,
} from "../../lib/daily-dove";

const { featured: lead, all } = await loadPaper();
const leadDesk = deskOf(lead);

/* The sheet is set in descending weight. Newest first — historical dispatches
   ranked by the year in their dateline — then cut into four bands, each of
   which is set differently below. */
const byRecency = all
  .slice()
  .sort((a, b) => postRank(b) - postRank(a))
  .filter((n) => n.id !== lead.id);

const secondaries = byRecency.slice(0, 2); // ruled columns beside the lead
const briefs = byRecency.slice(2, 7); // one-line notices under them
const alsoIn = byRecency.slice(7, 12); // the "Also In This Edition" list
const latest = byRecency.slice(12, 20); // the run below the fold

/* The desks, each with what it holds. A desk with nothing filed is still shown
   — it is a standing department of the paper, not a tag that happens to have
   entries, and a newsroom does not hide a desk because it had a quiet week. */
const desks = FILING_DESKS.map((d) => {
  const filed = byRecency.filter((n) => n.desk === d.id);
  return {
    d,
    total: all.filter((n) => n.desk === d.id).length,
    latest: filed[0],
  };
});

/* The archive's own shape: how many sheets survive from each age, and from each
   level of evidence. These are counts of what is actually filed — the page never
   advertises a shelf that is empty. */
const eras = ERAS.map((e) => ({
  e,
  total: all.filter((n) => eraOf(n.century).id === e.id).length,
})).filter((x) => x.total > 0);

const topics = WONDERS.map((w) => ({
  w,
  total: all.filter((n) => n.miracles?.includes(w.id)).length,
})).filter((x) => x.total > 0);

const ledger = EVIDENCE_LIST.map((k) => ({
  k,
  ev: EVIDENCE[k],
  total: all.filter((n) => n.evidence === k).length,
})).filter((x) => x.total > 0);

/* Roman numerals for the wax seal and the volume line — a century is stamped,
   not printed. */
function roman(n: number): string {
  const t: [number, string][] = [
    [1000, "M"],
    [900, "CM"],
    [500, "D"],
    [400, "CD"],
    [100, "C"],
    [90, "XC"],
    [50, "L"],
    [40, "XL"],
    [10, "X"],
    [9, "IX"],
    [5, "V"],
    [4, "IV"],
    [1, "I"],
  ];
  let out = "";
  for (const [v, s] of t)
    while (n >= v) {
      out += s;
      n -= v;
    }
  return out;
}

/* The standing notices — the classified column a paper runs down its margin.
   Written in the period register, but every one of them points at something
   this site genuinely offers. A notice advertising a thing that does not exist
   would be the one place the conceit tipped over into fiction. */
const NOTICES = [
  {
    head: "Wanted: A Patron",
    body: "Persons seeking an intercessor in sickness, in travel, in work, or in any trouble whatsoever may consult the Finder. No charge. All hours.",
    cue: "Consult the Finder",
    href: "quiz",
  },
  {
    head: "The Calendar of the Church",
    body: "Every day's commemorations, reckoned by the New Calendar and the Old, with the fasts marked and the Great Feasts set in gold.",
    cue: "Read today's date",
    href: "calendar",
  },
  {
    head: "Corrections Invited",
    body: "The proprietors solicit the notice of any reader who finds an error of fact in these columns. Corrections are received gratefully and published.",
    cue: "Write to the paper",
    href: "corrections",
  },
];
---

<BaseLayout
  active="daily-dove"
  title="The Daily Dove — The Living Archive"
  description="The Living Archive: two thousand years of the Church's story, preserved as though a newspaper had been there to report every major moment — with the evidence behind every dispatch set out plainly."
>
  <div class="dv dove dv-grain">
    {/* ============ NAMEPLATE ============ */}
    {
      /* The folio line. A paper numbers its volume by its run, and this one has
         been running a century per volume since Pentecost — so the volume IS the
         current century (21) and the number is the count of sheets kept. */
    }
    <div class="dove-mastwrap">
      <DoveMasthead
        edition={`Vol. ${roman(21)} · No. ${all.length}`}
        folio="Kept since Pentecost, A.D. 33"
      />
      <p class="dove-standfirst">{DOVE_STANDFIRST}</p>
      {
        /* The page's one piece of ornament. It was on every section head in the
           first build; four engraved bands down one page is a scrapbook. */
      }
      <div class="dove-mastorn">
        <Headpiece color="var(--dv-gold-aged)" size={22} />
      </div>
    </div>

    {
      /* ============ THE FRONT PAGE ============
        Lead, secondaries, briefs and the margin, in one broadsheet grid. */
    }
    <section class="dove-front">
      {/* --- the lead --- */}
      <article class="fp-lead">
        {lead.kicker && <span class="dv-kicker">{lead.kicker}</span>}
        <a class="fp-lead-link" href={withBase(`daily-dove/${lead.id}`)}>
          <h2 class="fp-lead-h">{lead.headline}</h2>
        </a>
        {lead.dek && <p class="fp-lead-dek">{lead.dek}</p>}

        <div class="fp-lead-byline">
          <span class="fp-lead-desk">{leadDesk.name}</span>
          <NewsMeta
            date={lead.date}
            location={lead.location}
            size={12.5}
            color="var(--dv-ink-3)"
          />
        </div>

        <hr class="dv-rule dv-rule--double fp-lead-rule" />

        <p class="fp-lead-sum dv-drop">{lead.summary}</p>

        <div class="fp-lead-foot">
          <a class="fp-read" href={withBase(`daily-dove/${lead.id}`)}>
            Read the dispatch in full
            <span aria-hidden="true">→</span>
          </a>
          <span class="fp-lead-ev">
            <EvidenceDot level={lead.evidence} withLabel={false} />
            <span>{EVIDENCE[lead.evidence].full}</span>
          </span>
        </div>
      </article>

      {
        /* --- the second column: two secondary stories, then the briefs ---
           HEADLINES, NOT SUMMARIES. Each secondary used to stack four
           treatments in a column a quarter of the measure wide — a desk label,
           the headline, three clamped lines of grey summary trailing an
           ellipsis, and a tinted era chip. That is more furniture than a
           narrow column can carry, and the truncated copy earned none of it:
           the headline is what a reader scans a second column for, and the
           story itself is one click away. Kicker and headline only. */
      }
      <div class="fp-second dv-colrule">
        <div class="dv-sect">
          <h2 class="dv-sect-h">More From This Edition</h2>
          <span class="dv-sect-ln"></span>
        </div>
        {
          secondaries.map((n) => (
            <a class="fp-sec" href={withBase(`daily-dove/${n.id}`)}>
              <span class="fp-sec-desk">{deskOf(n).name}</span>
              <h3 class="fp-sec-h">{n.headline}</h3>
            </a>
          ))
        }

        <div class="fp-briefwrap">
          <div class="dv-sect fp-briefhead">
            <h2 class="dv-sect-h">In Brief</h2>
            <span class="dv-sect-ln"></span>
          </div>
          <ul class="fp-briefs">
            {
              briefs.map((n) => (
                <li>
                  <a href={withBase(`daily-dove/${n.id}`)}>
                    <span class="fp-brief-cen">{ord(n.century)}&nbsp;c.</span>
                    <span class="fp-brief-h">{n.headline}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {
        /* --- the margin ---
           Two items only. It carried a third (an archivist's note with its own
           wax seal) and that was one voice too many beside a pull quote: the
           era entries below already say which run a sheet belongs to. */
      }
      <aside class="fp-margin dv-colrule">
        {
          lead.pullQuote && (
            <blockquote class="fp-margin-q">
              <p>{lead.pullQuote.text}</p>
              <cite>{lead.pullQuote.attribution}</cite>
            </blockquote>
          )
        }

        <div class="fp-thisday">
          <span class="dv-kicker">This Day in the Archive</span>
          <div class="fp-thisday-date">
            <span>{NEWS_THISDAY.date}</span>
            <em>A.D. {NEWS_THISDAY.year}</em>
          </div>
          <h3>{NEWS_THISDAY.title}</h3>
          <p>{NEWS_THISDAY.body}</p>
        </div>
      </aside>
    </section>

    {
      /* ============ ALSO IN THIS EDITION ============
        A single ruled strip of headlines across the measure — the row of
        one-line pointers a front page runs at its foot. Headlines only: the
        desk label under each was a second row of type doing no work. */
    }
    <section class="dove-also">
      <div class="dove-also-lab">Also In This Edition</div>
      <ul class="dove-also-list">
        {
          alsoIn.map((n) => (
            <li>
              <a href={withBase(`daily-dove/${n.id}`)}>{n.headline}</a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      /* ============ LATEST DISPATCHES ============
        Set at two weights: the first two as features with their copy in two
        columns, the rest as a stack of one-line entries with the notice column
        beside them. Deliberately NOT a grid of equal cards. */
    }
    <section class="dove-latest">
      <div class="dv-sect">
        <h2 class="dv-sect-h">Latest Dispatches</h2>
        <span class="dv-sect-ln"></span>
        <span class="dv-sect-note">In the order received</span>
      </div>

      <div class="dove-latest-grid">
        <div class="dove-latest-main">
          {
            latest.slice(0, 2).map((n) => (
              <article class="lat-feature">
                <span class="lat-desk">{deskOf(n).name}</span>
                <a href={withBase(`daily-dove/${n.id}`)}>
                  <h3>{n.headline}</h3>
                </a>
                <NewsMeta
                  date={n.date}
                  location={n.location}
                  size={12}
                  color="var(--dv-ink-3)"
                />
                <p class="lat-sum">{n.summary}</p>
                <span class="lat-tags">
                  <EraPill century={n.century} />
                </span>
              </article>
            ))
          }

          <ul class="lat-stack">
            {
              latest.slice(2).map((n) => (
                <li>
                  <a href={withBase(`daily-dove/${n.id}`)}>
                    <span class="lat-stack-cen">{ord(n.century)}</span>
                    <span class="lat-stack-body">
                      <span class="lat-stack-h">{n.headline}</span>
                      <span class="lat-stack-meta">
                        {n.location} · {deskOf(n).short}
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {/* the classified column — standing notices, set as small ads */}
        <aside class="dove-notices">
          <div class="dove-notices-head">Notices</div>
          {
            NOTICES.map((ad) => (
              <a class="dv-sheet notice" href={withBase(ad.href)}>
                <h3>{ad.head}</h3>
                <p>{ad.body}</p>
                <span class="notice-cue">{ad.cue} →</span>
              </a>
            ))
          }
        </aside>
      </div>
    </section>

    {
      /* ============ THE DEPARTMENTS ============
        The newsroom, listed as a masthead index. The columns that run inside
        other desks' dispatches (Voices from the Forum, Whispers, Fact Check,
        the Historian's Desk) used to be listed here too, in a second panel;
        that was inside-baseball on a front page, and a reader meets them where
        they actually appear — inside a dispatch. */
    }
    <section class="dove-depts">
      <div class="dove-secthead">
        <h2>Our Departments</h2>
        <p>Every dispatch is filed by a desk. Each desk keeps its own beat.</p>
      </div>

      <div class="dove-deptlist">
        {
          desks.map(({ d, total, latest: recent }) => (
            <article class="dept" style={`--dept-ink:${d.ink}`}>
              <header>
                <span class="dept-dm" aria-hidden="true" />
                <h3>{d.name}</h3>
                <span class="dept-n">{total}</span>
              </header>
              <p class="dept-rule">{d.rule}</p>
              {recent && (
                <a
                  class="dept-latest"
                  href={withBase(`daily-dove/${recent.id}`)}
                >
                  <span>Latest:</span> {recent.headline}
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    {/* ============ THE ARCHIVE ============ */}
    <section class="dove-archive">
      <a class="dv-sheet dv-foxed arch" href={withBase("daily-dove/archive")}>
        <div class="arch-seal">
          <WaxSeal mark="☦" size={58} color="var(--dv-stock)" />
        </div>
        <div class="arch-body">
          <span class="dv-kicker">The Stacks</span>
          <h2>Enter the Archive</h2>
          <p>
            Every sheet the paper has kept — {all.length} dispatches across {
              eras.length
            } ages of the Church — indexed by century, by place, by saint, by desk,
            and by the level of evidence that carries it.
          </p>
          <span class="arch-cue">Enter the archive →</span>
        </div>
      </a>
    </section>

    {
      /* ============ BROWSE BY ERA ============
        The archive's shelves. Each age keeps its own motif — the one place the
        "a run of papers, not one paper" idea is stated outright — but these are
        RULED ENTRIES, not plates. They were six filled colour blocks with wax
        seals, and six saturated rectangles in a row was the single busiest
        thing on the page. The era's ink now shows as a hairline and the motif;
        that is enough to tell the six apart. */
    }
    <section class="dove-eras">
      <div class="dove-secthead">
        <h2>Browse the Archive by Age</h2>
        <p>
          The paper has been set in every century since the Apostles. Each age
          left its own sheets, and its own way of printing them.
        </p>
      </div>

      <div class="dove-eragrid">
        {
          eras.map(({ e, total }) => (
            <a
              class="era"
              href={withBase(`daily-dove/archive#era-${e.id}`)}
              style={`--era-ink:${e.ink}`}
            >
              <div class="era-orn">
                <Headpiece
                  era={e}
                  color="var(--era-ink)"
                  size={22}
                  rules={false}
                />
              </div>
              <h3>{e.name}</h3>
              <span class="era-run">{e.edition}</span>
              <p class="era-strap">{e.strap}</p>
              <span class="era-foot">
                <em>
                  {ord(e.from)}–{ord(e.to)} century
                </em>
                <span class="era-n">{total} kept</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    {
      /* ============ BROWSE BY TOPIC ============
        A classified column, three across. Each entry carried a line of
        explanation under it; eleven of those made a wall of small grey type
        for an index whose whole job is to be scanned. The names carry it. */
    }
    <section class="dove-topics">
      <div class="dove-secthead">
        <h2>Browse by What Was Asked For</h2>
        <p>
          The Church asks the saints to pray; she does not trade in outcomes.
          These are the troubles the accounts themselves report help in.
        </p>
      </div>
      <ul class="dove-topiclist">
        {
          topics.map(({ w, total }) => (
            <li>
              <a href={withBase(`daily-dove/archive#wonder-${w.id}`)}>
                <span class="topic-h">{w.name}</span>
                <span class="topic-n">{total}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      /* ============ THE HISTORIAN'S DESK ============
        The department that runs at the foot of every dispatch, given its own
        standing at the foot of the front page. The ledger beside it is the
        archive's own accounting of itself: how much of what it holds is
        documented. */
    }
    <section class="dove-hist">
      <div class="hist-inner">
        <div class="hist-lede">
          <span class="dv-kicker">Standing Department</span>
          <h2>The Historian’s Desk</h2>
          <p>
            Every dispatch in this archive is told with relish. None of it is
            told without an account of where it comes from. At the foot of each
            sheet, this desk sets out what contemporary sources actually say,
            what the later tradition of the Church adds, what is medieval, and
            what is frankly legend — strand by strand, and never blurred
            together.
          </p>
          <p class="hist-p2">
            A reader should be able to enjoy the whole of a story and still know
            exactly which part of it would stand up in a footnote. That is the
            entire reason the paper is set this way.
          </p>
        </div>

        <div class="hist-ledger">
          <div class="hist-ledger-head">What the archive holds</div>
          {
            ledger.map(({ ev, total }) => (
              <div class="hist-row" style={`--hr-ink:${ev.dot}`}>
                <span class="hist-dot" />
                <span class="hist-lab">{ev.full}</span>
                <span class="hist-n">{total}</span>
              </div>
            ))
          }
          <p class="hist-foot">
            Counted by the strongest level each dispatch as a whole rests on.
            Within a dispatch, individual claims are weighed one at a time.
          </p>
        </div>
      </div>
    </section>

    {
      /* ============ HOW TO READ THIS PAPER ============
        Folded shut, and last. It was the third thing on the page before, which
        asked a visitor to learn a legend before reading a word — the reverse of
        how anyone picks up a newspaper. Fall into the illusion first; the key is
        here for whoever wants it. */
    }
    <section class="dove-key">
      <details class="key">
        <summary>
          <span class="key-h">How to Read This Paper</span>
          <span class="key-note">
            The marks beside every dispatch, explained
          </span>
          <span class="key-caret" aria-hidden="true">+</span>
        </summary>
        <div class="key-body">
          <p class="key-intro">
            The stories are told with relish. The evidence behind them is not.
            Every dispatch carries one of these marks, and closes with the
            Historian’s Desk setting out which parts of it rest on which.
          </p>
          <EvidenceKey />
        </div>
      </details>
    </section>
  </div>
</BaseLayout>

<style>
  /* ============================================================
     The sheet — newsprint, not navy. See the palette note at the top of
     daily-dove-paper.css for why the ground changed, and why almost nothing
     on this page carries a fill.
     ============================================================ */
  .dove {
    background: var(--dv-stock);
    color: var(--dv-ink-2);
    /* the whole section is set to a broadsheet measure */
    --dv-pad: clamp(20px, 4vw, 56px);
  }
  .dove :global(a) {
    text-decoration: none;
  }

  /* ---------- nameplate ---------- */
  .dove-mastwrap {
    padding: 10px var(--dv-pad) 30px;
  }
  .dove-standfirst {
    font-family: var(--serif);
    font-size: clamp(16px, 1.7vw, 21px);
    color: var(--dv-ink-2);
    line-height: 1.5;
    max-width: 68ch;
    margin: 22px auto 0;
    text-align: center;
    text-wrap: pretty;
  }
  .dove-mastorn {
    max-width: 380px;
    margin: 22px auto 0;
  }

  /* ============ THE FRONT PAGE ============
     Three columns of very different weight. The lead takes roughly half the
     measure, the secondaries a quarter, the margin the rest — the proportions a
     broadsheet actually uses, rather than three equal thirds. */
  .dove-front {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr) minmax(0, 0.82fr);
    gap: 0 34px;
    padding: 8px var(--dv-pad) 0;
    align-items: start;
  }

  /* --- the lead --- */
  .fp-lead {
    min-width: 0;
    padding-right: 34px;
    border-right: 1px solid var(--dv-rule-soft);
  }
  .fp-lead-h {
    font-family: var(--dove-plate);
    font-weight: 900;
    font-size: clamp(34px, 4.6vw, 66px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--dv-navy);
    margin: 8px 0 0;
    text-wrap: balance;
  }
  .fp-lead-link:hover .fp-lead-h {
    color: var(--dv-burgundy);
  }
  .fp-lead-dek {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 1.9vw, 25px);
    line-height: 1.34;
    color: var(--dv-ink-2);
    margin: 14px 0 0;
    text-wrap: pretty;
  }
  .fp-lead-byline {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  .fp-lead-desk {
    font-family: var(--text);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--dv-ink);
  }
  .fp-lead-rule {
    margin: 16px 0 18px;
  }
  /* the lead's copy is set in two columns with a dropped capital — the single
     strongest signal on the page that this is a printed sheet and not a card */
  .fp-lead-sum {
    font-family: var(--text);
    font-size: 16px;
    line-height: 1.7;
    color: var(--dv-ink-2);
    margin: 0;
    column-count: 2;
    column-gap: 32px;
    column-rule: 1px solid var(--dv-rule-soft);
    text-wrap: pretty;
  }
  .fp-lead-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--dv-rule-soft);
  }
  .fp-read {
    font-family: var(--text);
    font-weight: 700;
    font-size: 14px;
    color: var(--dv-burgundy);
  }
  .fp-read:hover {
    text-decoration: underline !important;
    text-underline-offset: 3px;
  }
  .fp-lead-ev {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--text);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--dv-ink-3);
  }

  /* --- secondary column --- */
  .fp-second {
    min-width: 0;
    border-left: none;
  }
  .fp-sec {
    display: block;
    padding: 0 0 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--dv-rule-soft);
  }
  .fp-sec-desk {
    font-family: var(--text);
    font-weight: 700;
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--dv-burgundy);
  }
  .fp-sec-h {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(21px, 2vw, 27px);
    line-height: 1.12;
    color: var(--dv-navy);
    margin: 6px 0 0;
    text-wrap: pretty;
  }
  .fp-sec:hover .fp-sec-h {
    color: var(--dv-burgundy);
  }

  .fp-briefwrap {
    margin-top: 4px;
  }
  .fp-briefs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fp-briefs li + li {
    border-top: 1px dotted var(--dv-rule-soft);
  }
  .fp-briefs a {
    display: flex;
    gap: 10px;
    padding: 9px 0;
    align-items: baseline;
  }
  /* The century gutter. Wide enough that "19th c." never breaks — at 34px it
     wrapped to two lines under every brief, which read as a layout fault. */
  .fp-brief-cen {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--dv-ink-3);
    flex: 0 0 48px;
    white-space: nowrap;
  }
  .fp-brief-h {
    font-family: var(--serif);
    font-size: 15.5px;
    line-height: 1.28;
    color: var(--dv-ink);
    text-wrap: pretty;
  }
  .fp-briefs a:hover .fp-brief-h {
    color: var(--dv-burgundy);
  }

  /* --- the margin --- */
  .fp-margin {
    min-width: 0;
    padding-left: 26px;
  }
  /* a pull quote set in the margin, the way a paper hangs one */
  .fp-margin-q {
    margin: 0 0 22px;
    padding: 14px 0 20px;
    border-top: 2px solid var(--dv-burgundy);
    border-bottom: 1px solid var(--dv-rule-soft);
  }
  .fp-margin-q p {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 1.9vw, 23px);
    line-height: 1.32;
    color: var(--dv-navy);
    margin: 0 0 10px;
    text-wrap: pretty;
  }
  .fp-margin-q cite {
    font-family: var(--text);
    font-style: normal;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--dv-ink-3);
  }

  .fp-thisday h3 {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.18;
    color: var(--dv-navy);
    margin: 8px 0 8px;
    text-wrap: pretty;
  }
  .fp-thisday p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--dv-ink-2);
    margin: 0;
    text-wrap: pretty;
  }
  .fp-thisday-date {
    display: flex;
    align-items: baseline;
    gap: 9px;
    margin-top: 6px;
  }
  .fp-thisday-date span {
    font-family: var(--serif);
    font-size: 27px;
    color: var(--dv-ink);
    line-height: 1;
  }
  .fp-thisday-date em {
    font-family: var(--text);
    font-style: normal;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--dv-ink-3);
  }

  /* ============ ALSO IN THIS EDITION ============ */
  .dove-also {
    margin: 34px var(--dv-pad) 0;
    padding: 14px 0;
    border-top: 2px solid var(--dv-ink);
    border-bottom: 1px solid var(--dv-rule);
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  .dove-also-lab {
    font-family: var(--text);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--dv-ink);
    padding-top: 5px;
  }
  .dove-also-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 2px 28px;
  }
  .dove-also-list a {
    display: block;
    padding: 4px 0;
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.3;
    color: var(--dv-ink);
    text-wrap: pretty;
  }
  .dove-also-list a:hover {
    color: var(--dv-burgundy);
  }

  /* ============ LATEST DISPATCHES ============ */
  .dove-latest {
    padding: 44px var(--dv-pad) 0;
  }
  .dove-latest-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 40px;
    align-items: start;
  }
  .dove-latest-main {
    min-width: 0;
  }

  /* the two features: two columns of copy under a rule */
  .lat-feature {
    padding: 15px 0 22px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--dv-rule-soft);
    border-top: 2px solid var(--dv-ink);
  }
  .lat-desk {
    font-family: var(--text);
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--dv-burgundy);
  }
  .lat-feature h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(24px, 2.5vw, 33px);
    line-height: 1.1;
    color: var(--dv-navy);
    margin: 7px 0 10px;
    text-wrap: balance;
  }
  .lat-feature a:hover h3 {
    color: var(--dv-burgundy);
  }
  .lat-sum {
    font-size: 14.5px;
    line-height: 1.66;
    color: var(--dv-ink-2);
    margin: 12px 0 12px;
    column-count: 2;
    column-gap: 30px;
    column-rule: 1px solid var(--dv-rule-soft);
    text-wrap: pretty;
  }
  .lat-tags {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  /* the stack: one line each, ruled — the tail of the run */
  .lat-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--dv-rule);
  }
  .lat-stack li {
    border-bottom: 1px solid var(--dv-rule-soft);
  }
  .lat-stack a {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
  }
  .lat-stack-cen {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--dv-ink-3);
    flex: 0 0 40px;
  }
  .lat-stack-body {
    min-width: 0;
  }
  .lat-stack-h {
    display: block;
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.24;
    color: var(--dv-ink);
    text-wrap: pretty;
  }
  .lat-stack a:hover .lat-stack-h {
    color: var(--dv-burgundy);
  }
  .lat-stack-meta {
    display: block;
    font-family: var(--text);
    font-size: 11.5px;
    color: var(--dv-ink-3);
    margin-top: 3px;
  }

  /* --- the notices column --- */
  .dove-notices-head {
    font-family: var(--text);
    font-weight: 700;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--dv-burgundy);
    text-align: center;
    padding-bottom: 10px;
    margin-bottom: 14px;
    border-bottom: 2px solid var(--dv-burgundy);
  }
  .notice {
    display: block;
    padding: 15px 17px 14px;
    margin-bottom: 13px;
    text-align: center;
  }
  .notice h3 {
    font-family: var(--dove-plate);
    font-weight: 900;
    font-size: 18px;
    line-height: 1.1;
    color: var(--dv-burgundy);
    margin: 0 0 8px;
    text-transform: uppercase;
  }
  .notice p {
    font-family: var(--serif);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--dv-ink-2);
    margin: 0 0 10px;
    text-wrap: pretty;
  }
  .notice-cue {
    font-family: var(--text);
    font-weight: 700;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--dv-burgundy);
    border-top: 1px solid var(--dv-rule);
    padding-top: 9px;
    display: block;
  }
  .notice:hover {
    background: var(--dv-stock-3);
  }
  .notice:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ============ section heads ============ */
  .dove-secthead {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 28px;
  }
  .dove-secthead h2 {
    font-family: var(--dove-plate);
    font-weight: 900;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.06;
    color: var(--dv-navy);
    margin: 0 0 10px;
    text-wrap: balance;
  }
  .dove-secthead p {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    line-height: 1.5;
    color: var(--dv-ink-3);
    margin: 0;
    text-wrap: pretty;
  }

  /* ============ DEPARTMENTS ============ */
  .dove-depts {
    padding: 56px var(--dv-pad) 0;
  }
  .dove-deptlist {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 2px solid var(--dv-ink);
  }
  .dept {
    padding: 18px 22px 20px;
    border-bottom: 1px solid var(--dv-rule-soft);
    border-right: 1px solid var(--dv-rule-soft);
    min-width: 0;
  }
  .dept:nth-child(3n) {
    border-right: none;
  }
  .dept header {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--dv-rule);
    margin-bottom: 10px;
  }
  /* the desk's ink survives as a lozenge — the one place it appears */
  .dept-dm {
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    background: var(--dept-ink);
    flex: 0 0 auto;
  }
  .dept h3 {
    font-family: var(--text);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--dv-ink);
    margin: 0;
    flex: 1;
    min-width: 0;
  }
  .dept-n {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 11px;
    color: var(--dv-ink-3);
  }
  .dept-rule {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--dv-ink-2);
    margin: 0;
    text-wrap: pretty;
  }
  .dept-latest {
    display: block;
    margin-top: 10px;
    font-family: var(--serif);
    font-size: 14px;
    line-height: 1.3;
    color: var(--dv-ink);
    text-wrap: pretty;
  }
  .dept-latest span {
    font-family: var(--text);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--dv-ink-3);
  }
  .dept-latest:hover {
    color: var(--dv-burgundy);
  }

  /* ============ THE ARCHIVE ============ */
  .dove-archive {
    padding: 52px var(--dv-pad) 0;
  }
  .arch {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 28px 32px;
    border-left: 3px solid var(--dv-burgundy);
  }
  .arch-seal {
    flex: 0 0 auto;
  }
  .arch-body {
    min-width: 0;
  }
  .arch h2 {
    font-family: var(--dove-plate);
    font-weight: 900;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.02;
    color: var(--dv-navy);
    margin: 8px 0 10px;
  }
  .arch p {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.55;
    color: var(--dv-ink-2);
    margin: 0 0 12px;
    max-width: 62ch;
    text-wrap: pretty;
  }
  .arch-cue {
    font-family: var(--text);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--dv-burgundy);
  }
  .arch:hover h2 {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ============ ERAS ============
     Ruled entries, not plates. The era's ink is a hairline at the top and the
     colour of its motif; there is no fill and no seal. */
  .dove-eras {
    padding: 56px var(--dv-pad) 0;
  }
  .dove-eragrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 34px;
  }
  .era {
    display: flex;
    flex-direction: column;
    padding: 16px 0 20px;
    border-top: 2px solid var(--era-ink);
    min-width: 0;
  }
  .era-orn {
    margin-bottom: 10px;
  }
  .era h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.08;
    color: var(--dv-navy);
    margin: 0 0 4px;
    text-wrap: pretty;
  }
  .era:hover h3 {
    color: var(--dv-burgundy);
  }
  .era-run {
    font-family: var(--text);
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--dv-ink-3);
  }
  .era-strap {
    font-family: var(--serif);
    font-style: italic;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--dv-ink-2);
    margin: 10px 0 14px;
    flex: 1;
    text-wrap: pretty;
  }
  .era-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--dv-rule-soft);
  }
  .era-foot em {
    font-family: var(--serif);
    font-size: 13.5px;
    color: var(--dv-ink-3);
  }
  .era-n {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--dv-ink-3);
  }

  /* ============ TOPICS ============
     A bare classified column: name and count, nothing else. */
  .dove-topics {
    padding: 56px var(--dv-pad) 0;
  }
  .dove-topiclist {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: 40px;
  }
  .dove-topiclist li {
    break-inside: avoid;
    border-bottom: 1px dotted var(--dv-rule-soft);
  }
  .dove-topiclist a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    font-family: var(--serif);
    font-size: 17.5px;
    line-height: 1.25;
    color: var(--dv-ink);
  }
  .dove-topiclist a:hover {
    color: var(--dv-burgundy);
  }
  .topic-n {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 10.5px;
    color: var(--dv-ink-3);
    flex: 0 0 auto;
  }
  @media (max-width: 1000px) {
    .dove-topiclist {
      columns: 2;
    }
  }
  @media (max-width: 700px) {
    .dove-topiclist {
      columns: 1;
    }
  }

  /* ============ THE HISTORIAN'S DESK ============ */
  .dove-hist {
    margin-top: 56px;
    padding: 42px var(--dv-pad);
    background: var(--dv-stock-2);
    border-top: 1px solid var(--dv-rule);
    border-bottom: 1px solid var(--dv-rule);
  }
  .hist-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 46px;
    align-items: start;
  }
  .hist-lede h2 {
    font-family: var(--dove-plate);
    font-weight: 900;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.02;
    color: var(--dv-navy);
    margin: 10px 0 16px;
  }
  .hist-lede p {
    font-size: 16px;
    line-height: 1.72;
    color: var(--dv-ink-2);
    margin: 0 0 14px;
    max-width: 62ch;
    text-wrap: pretty;
  }
  .hist-p2 {
    font-family: var(--serif);
    font-style: italic;
    font-size: 17px !important;
    color: var(--dv-navy) !important;
  }
  .hist-ledger {
    border-top: 2px solid var(--dv-ink);
    padding-top: 4px;
  }
  .hist-ledger-head {
    font-family: var(--text);
    font-weight: 700;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--dv-ink);
    padding: 10px 0 10px;
    border-bottom: 1px solid var(--dv-rule);
  }
  .hist-row {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px 0;
    border-bottom: 1px dotted var(--dv-rule-soft);
  }
  .hist-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--hr-ink);
    flex: 0 0 auto;
  }
  .hist-lab {
    flex: 1;
    font-family: var(--serif);
    font-size: 15px;
    color: var(--dv-ink);
    line-height: 1.25;
  }
  .hist-n {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 12px;
    color: var(--dv-ink-3);
  }
  .hist-foot {
    font-family: var(--serif);
    font-style: italic;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--dv-ink-3);
    margin: 12px 0 0;
    text-wrap: pretty;
  }

  /* ============ THE KEY, FOLDED ============ */
  .dove-key {
    padding: 32px var(--dv-pad) 60px;
  }
  .key {
    border: 1px solid var(--dv-rule);
  }
  .key summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    cursor: pointer;
    list-style: none;
  }
  .key summary::-webkit-details-marker {
    display: none;
  }
  .key-h {
    font-family: var(--text);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--dv-ink);
  }
  .key-note {
    flex: 1;
    font-family: var(--serif);
    font-style: italic;
    font-size: 14px;
    color: var(--dv-ink-3);
    min-width: 0;
  }
  .key-caret {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 17px;
    color: var(--dv-ink-3);
    flex: 0 0 auto;
  }
  .key[open] .key-caret {
    transform: rotate(45deg);
  }
  .key summary:hover .key-h {
    color: var(--dv-burgundy);
  }
  .key-body {
    padding: 4px 20px 22px;
    border-top: 1px solid var(--dv-rule-soft);
  }
  .key-intro {
    font-family: var(--serif);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--dv-ink-2);
    margin: 16px 0 18px;
    max-width: 72ch;
    text-wrap: pretty;
  }

  /* ============ responsive ============ */
  @media (max-width: 1180px) {
    .dove-front {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
    .fp-margin {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: none;
      margin-top: 26px;
      padding-top: 22px;
      border-top: 2px solid var(--dv-ink);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 28px;
    }
    .fp-margin-q {
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 0;
    }
    .dove-eragrid,
    .dove-deptlist {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .dept:nth-child(3n) {
      border-right: 1px solid var(--dv-rule-soft);
    }
    .dept:nth-child(2n) {
      border-right: none;
    }
  }
  @media (max-width: 1000px) {
    .dove-latest-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }
    .hist-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }
  }
  @media (max-width: 860px) {
    .dove-front {
      grid-template-columns: minmax(0, 1fr);
    }
    .fp-lead {
      padding-right: 0;
      border-right: none;
      padding-bottom: 26px;
      border-bottom: 1px solid var(--dv-rule-soft);
      margin-bottom: 26px;
    }
    .fp-lead-sum,
    .lat-sum {
      column-count: 1;
    }
    .dove-also {
